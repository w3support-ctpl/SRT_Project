<div class="card-header">
    <h3 class="card-title">Change Password</h3>
</div>
<div class="card-body">
    <div class="form-group">
        <label class="form-label text-dark">New Password</label>
        <input type="password" id="txtLoginNewPassword" class="form-control"
               placeholder="" autocomplete="off" onkeypress="ClearInvalidState(this);">
    </div>
    <div class="form-group">
        <label class="form-label text-dark">Confirm New Password</label>
        <input type="password" id="txtLoginConfirmNewPassword" class="form-control"
               placeholder="" autocomplete="off" onkeypress="ClearInvalidState(this);">
        <div class="invalid-feedback">Both Passwords should match.</div>
    </div>
    <div id="loaderLogin" class="dimmer active" style="display: none; margin-top: -170px; margin-bottom: 106px;">
        <div class="lds-ring" style="margin: auto auto;"><div></div><div></div><div></div><div></div></div>
    </div>
    <div class="form-footer mt-2">
        <a id="btnChangePassword" href="javascript: void(0)" class="btn btn-primary btn-block" onclick="ChangePassword();">
            <span id="lblSubmit">Submit</span>
        </a>
    </div>
    <div class="form-group text-right mt-3">
        <a id="btnCancel" href="javascript: void(0)" onclick="ShowLoginDiv();">Go Back</a>
    </div>
</div>