@{
    ViewData["Title"] = "Dealer Stock";
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Dealer Stock</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Secondary</a></li>
            <li class="breadcrumb-item active" aria-current="page">Dealer Stock</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Dealer Stock List</div>
                    <div class="card-options">
                        <a href="javascript:void(0);" class="btn btn-primary btn-sm" onclick="ShowAddEntry();"><i class="fa fa-plus mr-2"></i> Add</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">

                        <div class="col-sm-12 col-md-3 col-lg-4">
                            <div class="form-group">
                                <label class="form-label-search">Dealer Name </label>
                                <select id="ddlSearchDealer" class="form-control select2 w-100" required="" onchange="ClearDataTable('tableSearch');">
                                    <option value="">Select Dealer Name</option>

                                </select>
                                <div class="invalid-feedback">Dealer Name must be selected.</div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Entry Period <span class="text-red">*</span></label>
                                <input type="text" class="form-control" id="txtSearchEntryPeriod" name="datefilter"
                                       placeholder="Entry Period"
                                       maxlength="50" autocomplete="off" onkeypress="ClearDataTable('tableSearch')">
                                <div class="invalid-feedback">Invalid Entry Period</div>
                            </div>
                        </div>
                        
                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search" onclick="GetSearchList(this);">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Entry No</th>
                                    <th>Dealer Name</th>
                                    <th>Entry Date</th>
                                    <th>Month & Year</th>
                                    <th>No of Items</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="divContent" class="row">
    </div>

</div>







@section Scripts {
    <script src="~/tran_js/secondary_dealer_stock.js" asp-append-version="true"></script>
}
