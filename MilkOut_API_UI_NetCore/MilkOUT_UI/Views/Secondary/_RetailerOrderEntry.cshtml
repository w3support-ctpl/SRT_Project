<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Retailer Order Entry</div>
            <div class="card-options">
                <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry()"><i
                        class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <div class="row">
                <span id="lblEntryId" hidden style="display: none;"></span>
                <span id="lblAction" hidden style="display: none;"></span>

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Dealer Name <span class="text-red">*</span></label>
                        <select id="ddlEntryDealerName" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this); changeDealer();">
                            <option value="">Select Dealer Name</option>

                        </select>
                        <div class="invalid-feedback">Dealer Name must be selected.</div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Retailer Name <span class="text-red">*</span></label>
                        <select id="ddlEntryRetailerName" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Retailer Name</option>
                        </select>
                        <div class="invalid-feedback">Retailer Name can't be blank.</div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Sales User Name <span class="text-red">*</span></label>
                        <select id="ddlEntrySalesPersonName" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Sales User</option>

                        </select>
                        <div class="invalid-feedback">Sales User must be selected.</div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Order No <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryOrderNo" disabled class="form-control"
                            placeholder="Enter Order No" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Order No.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Order Date <span class="text-red">*</span></label>
                        <input type="date" id="txtEntryOrderDate" disabled class="form-control"
                            placeholder="Enter Order Date" maxlength="50" autocomplete="off"
                            onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Order Date.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Remarks <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryRemarks" class="form-control" placeholder="Enter Remarks"
                            maxlength="200" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Remarks.</div>
                    </div>
                </div>
            </div>

            <div id="divItemList" class="row" style="display:none;">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Retailer Item Order List</div>
                            <div class="card-options">
                                <a id="btn_Modal_Add" href="#" class="btn btn-primary btn-sm mr-2" data-toggle="modal"
                                    data-target="#modelEntryRetailerOrder" onclick="ShowModalEntry('Add','')"><i
                                        class="fa fa-plus mr-2"></i> Add</a>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="tableItemList"
                                    class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                    <thead>
                                        <tr>
                                            <th style="width: 20px;">#</th>
                                            <th>Item Code</th>
                                            <th>Item Name</th>
                                            <th>Item UOM</th>
                                            <th>Quantity</th>
                                            <!--
                                            <th>Rate</th>
                                            <th>Amount</th>
                                            -->
                                            <th class="text-right" style="width: 50px;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tableItemEntry">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
        <!--FOOTER-->
        <div class="card-footer text-right">
            @* <div class="d-flex">
            <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry('');"><i
            class="fa fa-trash"></i></button>
            </div>*@
        </div>

    </div>
</div>


<div class="modal fade" id="modelEntryRetailerOrder" tabdocumentation="-1" role="dialog" aria-hidden="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="AddEditRoute">Add Item</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 col-md-2 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalItem" class="form-control-label">Item <span
                                    class="text-red">*</span></label>
                            <select id="ddlModalItem" class="form-control select2 w-100" required=""
                                onchange="ClearInvalidState(this);GetProductUOMtList();">
                                <option value="">Select Item</option>
                            </select>
                            <span hidden id="lblModalAction"></span>
                            <span hidden id="lblModalId"></span>
                            <div class="invalid-feedback">Item must be selected.</div>
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-2 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalItem" class="form-control-label">Item UOM<span
                                    class="text-red">*</span></label>
                            <select id="ddlModalItemUOM" class="form-control select2 w-100" required=""
                                onchange="ClearInvalidState(this);">
                                <option value="">Select Item UOM</option>
                            </select>
                            <div class="invalid-feedback">Item UOM must be selected.</div>
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-2 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalQuantity" class="form-control-label">Quantity <span
                                    class="text-red">*</span></label>
                            <input type="number" class="form-control" id="txtModalQuantity" placeholder="Enter Quantity"
                                autocomplete="off" value="0">
                            <div class="invalid-feedback">Invalid Quantity</div>
                        </div>
                    </div>

                    <!--
                    <div class="col-lg-6 col-md-2 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalRate" class="form-control-label">Rate </label>
                            <input type="text" class="form-control" id="txtModalRate" disabled placeholder="Enter Rate"
                                   maxlength="50" autocomplete="off" value="0">
                        </div>
                    </div>


                    <div class="col-lg-6 col-md-2 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalAmount" class="form-control-label">Amount</label>
                            <input type="text" class="form-control" id="txtModalAmount" disabled>
                            <div class="invalid-feedback">Invalid Amount</div>
                        </div>
                    </div>
                    -->

                </div>
            </div>
            <div class="modal-footer" style="justify-content:flex-start">
                <button type="button" class="btn btn-primary" id="btn_SaveItem" onclick="SaveItemEntry();">Save</button>
            </div>

        </div>
    </div>
</div>
