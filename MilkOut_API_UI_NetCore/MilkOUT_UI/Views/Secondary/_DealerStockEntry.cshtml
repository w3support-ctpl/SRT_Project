<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Dealer Stock Entry</div>
            <div class="card-options">
                <a id="btn_Save" style="display:none;" href="#" class="btn btn-primary btn-sm mr-2"
                   onclick="SaveEntry()"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-4 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Dealer Name <span class="text-red">*</span></label>
                        <select id="ddlEntryDealer" class="form-control select2 w-100" required=""
                                onchange="ClearInvalidState(this); ClearDataTable('tableProducts');">
                            <option value="">Select Dealer Name</option>
                        </select>
                        <span hidden id="lblEntryId"></span>
                        <span hidden id="lblAction"></span>
                        <div class="invalid-feedback">Dealer Name can't be blank.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Month & Year <span class="text-red">*</span></label>
                        <input type="month" id="txtEntryMonthYear" class="form-control"
                               onchange="ClearInvalidState(this);"                               onkeydown="return false" />
                        <div class="invalid-feedback">Month & Year can't be blank.</div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3 col-md-3">
                    <button class="btn btn-sm btn-secondary mt-5" style="height: calc(1.47em + 1rem + 2px);"
                            type="button" title="Search" onclick="GetSearchProductList(this);">
                        <i class="fa fa-search mr-2"></i> Search
                    </button>
                </div>
            </div>

