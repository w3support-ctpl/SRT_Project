<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Route Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i
                        class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0);" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!--ENTRY SECTION-->
            <div class="row">

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Route Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryRouteName" class="form-control" placeholder="Enter Route Name"
                            maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Route Name can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div id="divEntryVehicle" class="col-lg-3 col-md-4 col-sm-12" style="display: none;">
                    <div class="form-group">
                        <label for="ddlEntryVehicle" class="form-label">Vehicle <span class="text-red">*</span></label>
                        <select id="ddlEntryVehicle" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Vehicle</option>
                        </select>
                        <div class="invalid-feedback">Vehicle must be selected.</div>
                    </div>
                </div>

                <div id="divEntryVehicleName" class="col-lg-3 col-md-4 col-sm-12" style="display: none;">
                    <div class="form-group">
                        <label class="form-label">Vehicle Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryVehicleName" class="form-control"
                            placeholder="Enter Vehicle Name" maxlength="50" autocomplete="off"
                            onkeypress="ClearInvalidState(this);" disabled>
                        <div class="invalid-feedback">Vehicle Name can't be blank.</div>
                    </div>
                </div>

            </div>

            <!--ROUTE ITEM-->
            <div id="divEntryRouteItemTable" class="row">
                <div class="col-12">
                    <div class="panel panel-primary">
                        <div>
                            <div class="user-tabs mb-4">
                                <!-- Tabs -->
                                <ul class="nav panel-tabs">
                                    <li class=""><a href="#tab1" class="active" data-toggle="tab">Entry</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="tab-content">
                        <div class="tab-pane active " id="tab1">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Route Item List</div>
                                    <div class="card-options">
                                        <a href="javascript:void(0);" class="btn btn-primary btn-sm mr-2"
                                            onclick="OpenModal('Add');"><i class="fa fa-plus mr-2"></i> Add</a>
                                    </div>
                                </div>
                                <div id="divItemSuccess" class="card-alert alert alert-success mb-0"
                                    style="display: none;">
                                    Save action was successful
                                </div>
                                <div id="divItemError" class="card-alert alert alert-danger mb-0"
                                    style="display: none;">
                                    Save action failed
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tablerouteitems"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 20px;">#</th>
                                                    <th>Name</th>
                                                    <th>Type</th>
                                                    @* <th>latitude</th>
                                                    <th>longitude</th> *@
                                                    <th class="text-right" style="width: 100px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntry">

                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--FOOTER DELETE-->
        <div id="divFooterDelete" class="card-footer text-right">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i
                        class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</div>
