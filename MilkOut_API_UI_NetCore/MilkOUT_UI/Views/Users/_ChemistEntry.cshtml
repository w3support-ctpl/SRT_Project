<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Chemist Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <a href="#" id="btn_Save" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!--ENTRY SECTION-->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Chemist Code <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryChemistCode" class="form-control" placeholder="Enter Chemist Code" maxlength="50" autocomplete="off">
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Chemist Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryChemistName" class="form-control" placeholder="Enter Chemist Name" maxlength="50" autocomplete="off">
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Joining Date <span class="text-red">*</span></label>
                        <input type="date" id="txtEntryJoiningDate" class="form-control" placeholder="Enter Joining Date" maxlength="20" autocomplete="off">
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Mobile No <span class="text-red">*</span></label>
                        <input type="tel" id="txtEntryMobileNo" class="form-control is-invalid state-invalid" placeholder="Enter Mobile No" maxlength="10" autocomplete="off">
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Pan No <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryPanNo" class="form-control" placeholder="Enter Pan No" maxlength="10" autocomplete="off">
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Aadhar No <span class="text-red">*</span></label>
                        <input type="tel" id="txtEntryAadharNo" class="form-control is-invalid state-invalid" placeholder="Enter Aadhar No" maxlength="12" autocomplete="off">
                        <div class="invalid-feedback">Invalid input</div>
                    </div>
                </div>
            </div>
        </div>
        <div id="divFooterActions" class="card-footer text-right">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</div>