                <div class="form-group">
                <label class="form-label">Destination <span class="text-red">*</span></label>
                <input type="text" id="txtEntryDestination" class="form-control" placeholder="Enter Destination"
                maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this)">
                <div class="invalid-feedback">Destination can't be blank.</div>
                </div>
                </div> *@
                @* <div class="col-lg-3 col-md-4 col-sm-12">
                <div class="form-group">
