                <input type="text" id="txtEntryCustomerReference" class="form-control" placeholder="Enter Customer
                Reference" maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this)">
                <div class="invalid-feedback">Customer Reference can't be blank.</div>
                </div>
                </div> *@

