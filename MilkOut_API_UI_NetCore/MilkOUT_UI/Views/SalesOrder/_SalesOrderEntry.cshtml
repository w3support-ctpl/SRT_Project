<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Sales Order Entry</div>
            <div class="card-options">
                <a id="btn_Save" href="javascript:void(0);" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();"
                    style="display: none;"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0);" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>

        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!--ENTRY SECTION-->
            <div class="row">
                <div class="col-lg-4 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Order Date</label>
                        <input type="date" id="txtEntryOrderDate" class="form-control" placeholder="Enter Order Date"
                            maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this)" />
                        <div class="invalid-feedback">Order Date can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>

                <div class="col-lg-4 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Select Dealer <span class="text-red">*</span></label>
                        <select id="ddlDealerName" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this); ChangeDealer();">
                            <option value="">Select Dealer</option>
                        </select>
                        <div class="invalid-feedback">Dealer Name must be selected</div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Sales Group <span class="text-red">*</span></label>
                        <select id="ddlEntrySalesArea" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this); GetSalesAreaName();">
                            <option value="">Select Sales Group</option>
                        </select>
                        <div class="invalid-feedback">Sales Group must be selected</div>
                    </div>
                </div>




