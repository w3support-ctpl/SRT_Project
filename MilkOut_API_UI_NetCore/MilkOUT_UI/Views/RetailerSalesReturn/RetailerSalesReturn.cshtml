@{
    ViewData["Title"] = "RetailerSalesReturn";
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Retailer Sales Return</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Secondary</a></li>
            <li class="breadcrumb-item active" aria-current="page">Retailer Sales Return</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Retailer Sales Return List</div>
                    <div class="card-options">
                        <a href="#" class="btn btn-primary btn-sm" onclick="ShowAddEntry();"><i class="fa fa-plus mr-2"></i> Add</a>
                    </div>
                </div>
                <div class="card-body">
                    <!--SEARCH FIELDS-->
                    <div class="row">
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Return Period <span class="text-red">*</span></label>
                                <input type="text" class="form-control" id="txtSearchReturnPeriod" name="datefilter"
                                       placeholder="Return Period"
                                       maxlength="50" autocomplete="off" onkeypress="ClearDataTable('tableSearch')">
                                <div class="invalid-feedback">Invalid Return Period</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Dealer Name <span class="text-red">*</span></label>
                                <select id="ddlSearchDealerName" class="form-control select2 w-100" required="">
                                    <option value="">Select Dealer Name</option>

                                </select>
                                <div class="invalid-feedback">Invalid input</div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button id="btn_Search" class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search" onclick="GetSearchList();">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">Entry No</th>
                                    <th>Retailer Name</th>
                                    <th>Sales Person</th>
                                    <th>Delivery Date</th>
                                    <th>No Of Items</th>
                                    <th class="text-right" style="width: 50px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                                <tr>
                                    <td style="width: 20px;">1</td>
                                    <td>Gurukrupa Stores</td>
                                    <td>ABC</td>
                                    <td>12 July 2023</td>
                                    <td>2</td>
                                    <td class="text-right" style="width: 50px; padding: 8px 5px 8px 5px;">
                                        <a href="javascript:void(0);" class="btn btn-icon py-0" title="Edit" onclick="ShowEditEntry('1');">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 20px;">2</td>
                                    <td>Panchavati Stores</td>
                                    <td>PQR</td>
                                    <td>12 July 2023</td>
                                    <td>3</td>
                                    <td class="text-right" style="width: 50px; padding: 8px 5px 8px 5px;">
                                        <a href="javascript:void(0);" class="btn btn-icon py-0" title="Edit" onclick="ShowEditEntry('2');">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divContent" class="row">
    </div>


</div>

@section Scripts{
    <script src="~/tran_js/retailersalesreturn.js" asp-append-version="true"></script>
}