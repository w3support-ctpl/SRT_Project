<style>
    .dropbtn {
        background-color: white;
        color: blue;
        /*  padding: 16px;
                    font-size: 16px;*/
        border: none;
        border-color: black;
    }

    .dropdown-content {
        display: none;
        position: absolute;
        background-color: white;
        min-width: 200px;
        box-shadow: 2px 2px 2px 2px rgba(0.1,0.1,0.1,0.1);
        z-index: 1;
        color: blue;
        right: 10px;
    }

        .dropdown-content a {
            color: black;
            padding: 7px 7px;
            text-decoration: none;
            display: block;
            text-align: right;
        }

    /* .dropdown-content a:hover {
                            background-color: #ddd;
                        }*/

    .dropdown:hover .dropdown-content {
        display: block;
    }

    .dropdown-content:before {
        position: absolute;
        top: -7px;
        right: 9px;
        display: inline-block;
        border-right: 7px solid transparent;
        border-bottom: 7px solid #ccc;
        border-right: 7px solid transparent;
        border-bottom-color: rgba(0, 0, 0, 0.2);
        content: '';
    }

    .dropdown-content:after {
        position: absolute;
        top: -6px;
        right: 10px;
        display: inline-block;
        border-right: 6px solid transparent;
        border-bottom: 6px solid #ffffff;
        border-right: 6px solid transparent;
        content: '';
    }

    .text-left {
        text-align: left !important;
    }
</style>
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title" id="lbltitle">View Invoice Details </div>
            <div class="card-options">
                @*  <a class="btn btn-sm btn-link" onclick="CloseEntry()">More</a>*@
                @* <div class="dropdown" style="text-align:left">
                <button class="dropbtn">More</button>
                <div class="dropdown-content">
                <a href="#">View flow</a><br />
                <a href="#">Place Credit Memo Request</a><br />
                <a href="#">Place Customer Return</a>
                </div>
                </div>*@

                <a id="btn_Save" href="javascript:void(0);" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();" ><i class="fa fa-save mr-2"></i> Save</a>
              
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseReturnEntry()">Close</a>
            </div>

        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!--ENTRY SECTION-->
           

            <div class="row" id="divTabs">
                <div class="col-12">
                    

                    <div class="tab-content">
                        <div class="tab-pane active" id="tab1">
                            <div class="card">
                                <span id="lblDocumentReferenceID" hidden style="display: none;"></span>
                                <lable id="lbltype" hidden style="display: none;"></lable>
                                <lable id="lblinvoiceno" hidden style="display: none;"></lable>

                                <lable id="invoice_no" hidden style="display: none;"></lable>
                                <lable id="invoice_amount" hidden style="display: none;"></lable>
                                <lable id="invoice_date" hidden style="display: none;"></lable>
                                <lable id="invoice_paymentterm" hidden style="display: none;"></lable>


                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableList" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th style="width: 20px;">Item Id</th>
                                                    <th>Item Description</th>
                                                    <th>Billing Quality</th>
                                                    <th>Billing UOM</th>
                                                    <th id="theadingreturn" >Return Quantity</th>
                                                    
                                                </tr>
                                            </thead>
                                            <tbody id="tableInvoiceItems">

                                            </tbody>

                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="tab-pane" id="tab2">
                        </div>
                        <div class="tab-pane " id="tab3">
                        </div>
                       
                    </div>



                </div>
            </div>

            <div class="card-footer text-right" id="divFooterDelete">
                <div class="d-flex">
                    
                </div>
            </div>

        </div>
    </div>
</div>




