<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Crate Dispatch To Dealer</div>
            <div class="card-options">

                <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-lg-4 col-md-3 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Dealer Name<span class="text-red">*</span></label>
                        <select id="txtEntryDealerName" class="form-control select2 w-100" 
                                required="" onchange="ClearInvalidState(this);">
                            <option value="">Select Dealer Name</option>
                        </select>
                        <div class="invalid-feedback">Dealer Name must be selected</div>
                    </div>
                </div> 
                <div class="col-lg-4 col-md-3 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Dispatch Date</label>
                        <input type="date" id="txtEntryDispatchDate" class="form-control">
                        <div class="invalid-feedback">Dispatch Date can't be blank</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-4 col-md-3 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Quantity<span class="text-red">*</span></label>
                        <input type="text" id="txtEntryQuantity" class="form-control" placeholder="Enter Quantity" maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this)">
                        <div class="invalid-feedback">Quantity can't be blank.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/tran_js/transaction_cratedispatchtodealer.js" asp-append-version="true"></script>
}
