
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">View Delivery</div>
            <div class="card-options">
               @* <label class="custom-switch" style="margin-right: 40px;">
                    Active Flag
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>*@
                @*<a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();"><i class="fa fa-save mr-2"></i> View Flow</a>*@
