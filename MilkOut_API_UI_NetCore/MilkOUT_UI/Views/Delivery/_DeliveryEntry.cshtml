                                                    <td style="width: 20px;">001</td>
                                                    <td>32.00</td>
                                                    <td>01 Jan 2023 10:00 AM</td>
                                                    <td>31 March 2023 04:00 PM</td>
                                                    <td>3.5</td>
                                                    <td>8.5</td>
                                                    @*<td class="text-right" style="width: 50px; padding: 8px 5px 8px 5px;">
                                                    <a href="javascript:void(0);" title="Edit" onclick="OpenModalBaseRate('Edit','1');">
                                                    <i class="fa fa-pencil"></i>
                                                    </a>
                                                    </td>*@
                                              @*  </tr>
                                                <tr>
                                                    <td style="width: 20px;">002</td>
                                                    <td>33.00</td>
                                                    <td>31 March 2023 04:00 PM</td>
                                                    <td>31 Jul 2023 12:00 AM</td>
                                                    <td>3.5</td>
                                                    <td>8.5</td>*@
                                                    @*<td class="text-right" style="width: 50px; padding: 8px 5px 8px 5px;">
                                                    <a href="javascript:void(0);" title="Edit" onclick="OpenModalBaseRate('Edit','2');">
                                                    <i class="fa fa-pencil"></i>
                                                    </a>
                                                    </td>*@
                                                @*</tr>*@
                                            </tbody>

                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="tab-pane" id="tab2">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Invoice Item</div>
                                    <div class="card-options">
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableInvoice" class="hover table table-bordered table-hover table-striped w-100 border-top-1 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 20px;">#</th>
                                                        <th>Invoice No.</th>
                                                        <th>Document Category</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableInvoiceItem">
                                            </tbody>

                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>



       

       
    </div>

   

</div>


@section Scripts{
    <script src="~/tran_js/delivery.js" asp-append-version="true"></script>
