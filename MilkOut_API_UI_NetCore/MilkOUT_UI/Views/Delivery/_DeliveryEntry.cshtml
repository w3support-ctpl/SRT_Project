                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
           
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Delivery Document</label>
                        <input type="text" id="txtEntryDeliveryId" class="form-control"  disabled>
                        <div class="invalid-feedback">Dealer Code can't be blank</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Delivery Date</label>
                        <input type="text" name="datefilter" id="txtEntryDeliveryDate" class="form-control" disabled>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Vehicle Number</label>
                        <input type="text" id="txtVehiceno" class="form-control" disabled>
                        
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Driver Name</label>
                        <input type="text" id="txtDriverName" class="form-control" disabled>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Loader Name</label>
                        <input type="text" id="txtLoaderName" class="form-control" disabled>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                  <div class="form-group">
                        <label class="form-label">Transporter Name</label>
                        <input type="text" id="txtTransporterName" class="form-control" placeholder="" autocomplete="off" disabled>
                  </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                <div class="form-group">
                        <label class="form-label">Vehicle Type</label>
                        <input type="text" id="txtVehicleType" class="form-control" placeholder="" autocomplete="off" disabled>
                </div>
            </div>
             </div>
          
            <div class="row" id="divTabs">
                <div class="col-12">
                    <div class="panel panel-primary">
                        <div>
                            <div class="user-tabs mb-4">
                                <!-- Tabs -->
                                <ul class="nav panel-tabs">
                                    <li class=""><a href="#tab1" class="active" data-toggle="tab">Order Details</a></li>
                                        <li><a href="#tab2" data-toggle="tab">Invoice</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="tab-content">
                        <div class="tab-pane active" id="tab1">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Billing Item</div>
                                    <div class="card-options">
                                   <span id="lblItemCount" hidden style="display: none;"></span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableBilling" class="hover table table-bordered table-hover table-striped w-100 border-top-1 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 20px;">#</th>
@*                                                    <th style="width: 100px;">Item</th>
*@                                                    <th>Material No</th>
                                                    <th>Item Description</th>
                                                    <th>Sales Order</th>
                                                    <th>Batch</th>
                                                    <th>Delivery Quantity</th>
                                                    <th>UOM</th>
@*                                                    <th>Plant</th>
*@                                                
                                                    <th>Taxable Amount</th>
                                                    @*<th class="text-right" style="width: 50px;">Action</th>*@
                                                </tr>
                                            </thead>
                                            <tbody id="tableBillingItem">
