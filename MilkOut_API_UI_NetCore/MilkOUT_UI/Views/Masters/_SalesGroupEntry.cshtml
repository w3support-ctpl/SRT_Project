<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Sales Group Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!--ENTRY SECTION-->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Sales Group Code  <span class="text-red">*</span></label>
                        <input type="text" id="txtEntrySalesAreaCode" class="form-control" placeholder="Enter Sales Group Code" maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this)" />
                        <div class="invalid-feedback">Sales Group Code can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Sales Group Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntrySalesAreaName" class="form-control" placeholder="Enter Sales Group Name" maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this)">
                        <div class="invalid-feedback">Sales Group Name can't be blank.</div>
                    </div>
                </div> 
            </div>          
            <!--OTHER DETAILS-->
        </div>
        <div class="card-footer text-right" id="divFooterDelete">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</div>