<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Dealer Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Flag
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <a id="btnSaveSalesGroup" href="#" class="btn btn-primary btn-sm mr-2" onclick="SalesGroupEntry();"><i
                        class="fa fa-download mr-2"></i> Sales Group</a>
                <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();"><i
                        class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>

        <div class="card-body">
            <!--ENTRY SECTION-->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Dealer Code<span class="text-red">*</span> </label>
                        <input type="text" id="txtEntryDealerCode" class="form-control" placeholder="Enter Dealer Code"
                            maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);" disabled>

                        <div class="invalid-feedback">Dealer Code can't be blank</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Dealer Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryDealerName" class="form-control" placeholder="Enter Dealer Name"
                            maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);" disabled>
                        <div class="invalid-feedback">Dealer Name can't be blank</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Sales Group <span class="text-red">*</span></label>
                        <select id="ddlEntrySalesArea" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Sales Group</option>
                        </select>
                        <div class="invalid-feedback">Sales Group must be selected</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Sales User <span class="text-red">*</span></label>
                        <select id="ddlEntrySalesUser" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Sales User</option>
                        </select>
                        <div class="invalid-feedback">Sales User must be selected</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">PAN No <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryDealerPan" class="form-control" placeholder="Enter PAN No"
                            maxlength="12" autocomplete="off" onkeypress="ClearInvalidState(this);" disabled>
                        <div class="invalid-feedback">Invalid PAN Number.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Phone No</label>
                        <input type="text" id="txtEntryPhoneNo" class="form-control" placeholder="Enter Phon No"
                            maxlength="10" autocomplete="off" onkeypress="ClearInvalidState(this);" disabled>
                        <div class="invalid-feedback">Invalid Phone Number.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Email Id</label>
                        <input type="text" id="txtEntryEmail" class="form-control" placeholder="Enter Email Id"
                            autocomplete="off" onkeypress="ClearInvalidState(this);" disabled>
                        <div class="invalid-feedback">Invalid Email Id </div>
                    </div>
                </div>

            </div>


            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Password </label>
                        <input type="text" id="txtEntryPassword" class="form-control" placeholder="Password"
                            autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Password.</div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Payment Url </label>
                        <input type="text" id="txtEntryPaymentUrl" class="form-control" placeholder="Payment Url"
                            autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Payment Url.</div>
                    </div>
                </div>



                <div class="col-lg-2 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Payment Flag </label>
                        <label class="custom-control custom-checkbox mt-3">
                            <input type="checkbox" id="chkPaymentFlag" class="custom-control-input" value="1">
                            <label for="chkPaymentFlag" class="custom-control-label text-dark">Active</label>
                        </label>
                        <div class="invalid-feedback">Invalid Input</div>
                    </div>
                </div>



            </div>

