@{
    ViewData["Title"] = "Sales User";
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Sales User</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Masters</a></li>
            <li class="breadcrumb-item active" aria-current="page">Sales User</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Sales User List</div>
                    <div class="card-options">
                        <a href="#" id="btn_Add" class="btn btn-primary btn-sm mr-2" onclick="ShowAddEntry();"><i
                                class="fa fa-plus mr-2"></i> Add</a>
                        <a href="#" id="btn_DayReOpen" class="btn btn-primary btn-sm mr-2" onclick="ShowDayReOpenEntry();"><i
                                class="fa fa-calendar mr-2"></i> Day ReOpen</a>
                    </div>
                </div>
                <div class="card-body">
                    <!-----     -----   -----   -----   SEARCH FIELDS   -----   -----   -----   ----->
                    <div class="row">
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Common Search</label>
                                <input type="text" class="form-control" id="txtSearchText"
                                    placeholder="Enter Search Text" required="" onchange="ClearDataTable('tableSearch')"
                                    style="font-size: .8375rem;" />
                                <div class="invalid-feedback">Invalid Search Text</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button id="btn_Search" class="btn btn-sm btn-secondary"
                                style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search"
                                onclick="GetSearchList();">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>
                    <!-----     -----   -----   -----   Sales User Records(TABLE)   -----   -----   -----   ----->
                    <div class="table-responsive">
                        <table id="tableSearch"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>

                                    <th> Sap Bp Partner Code </th>
                                    <th> Sales User Name </th>
                                    <th> Sales Employee </th>
                                    <th> Sales User Code </th>
                                    <th> Role Name </th>
                                    <th> Reporting To </th>
                                    <th> Route Name </th>
                                    <th> Mobile No </th>
                                    <th> Email Id </th>
                                    @* <th> Birth Date </th> *@
                                    <th> Joining Date </th>
                                    <th> Address Text </th>
                                    <th> State Name </th>
                                    <th> District Name </th>
                                    <th> Taluka Name </th>
                                    <th> City Name </th>
                                    <th> Pincode </th>
                                    <th> Pan No </th>
                                    <th> Aadhar No </th>
                                    <th> Bank Name </th>
                                    <th> Account No </th>
                                    <th> Ifsc Code </th>
                                    <th> Account Name </th>
                                    <th> Status </th>
                                    <th class="text-right" style="width: 50px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divContent" class="row">
    </div>


</div>

<div class="modal fade" id="modalEntry" tabdocumentation="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog modal-xl" role="document" style="width: 85% !important;">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="AddEdit">Sales User Day ReOpen</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">

				<div class="table-responsive" style="height: 500px !important;overflow: auto !important;">
					<table id="tableEntryModal"
						class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
						<thead>
							<tr>
								<th style="width: 20px;">#</th>
								<th>SalesUser Name</th>
								<th>Route Name</th>
								<th>RouteDay Name</th>
								<th>Start Time</th>
								<th>End Time</th>
								<th>Date</th>
                                <th>Status</th>
								<th class="text-right" style="width: 50px;">Action</th>
							</tr>
						</thead>
						<tbody id="tableEntryModalData">

						</tbody>

					</table>
				</div>
			</div>

		</div>
	</div>
</div>

@section Scripts {
    <script src="~/tran_js/master_salesuser.js" asp-append-version="true"></script>
}