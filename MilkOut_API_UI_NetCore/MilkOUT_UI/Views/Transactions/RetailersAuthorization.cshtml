@{
    ViewData["Title"] = "Retailers Authorization";
}
<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Retailers Authorization</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Transactions</a></li>
            <li class="breadcrumb-item active" aria-current="page">Retailers Authorization</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Retailers Authorization List</div>
                    <div class="card-options">
                    </div>
                </div>
                <div class="card-body">
                    <!--SEARCH FIELDS-->
                    <div class="row">
                        <div class="col-sm-4 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Sales User Name</label>
                                <select id="ddlSearchSalesUserName" class="form-control select2 w-100"
                                        required="" onchange="ClearInvalidState(this)">
                                    <option value="">All</option>
                                </select>
                                <div class="invalid-feedback">Dealer Name must be selected</div>
                            </div>
                        </div>
                        <div class="col-sm-4 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Approval Status</label>
                                <select id="ddlSearchApprovalStatus" class="form-control select2 w-100"
                                        required="" onchange="ClearInvalidState(this)">
                                    <option value="">Pending</option>
                                </select>
                                <div class="invalid-feedback">Approval Status must be selected</div>
                            </div>
                        </div>
                        <div class="col-sm-4 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Request Period<span class="text-red">*</span></label>
                                <input type="text" class="form-control" id="txtSearchRequestPeriod" name="datefilter"
                                       placeholder="Request Period"
                                       maxlength="50" autocomplete="off" onkeypress="ClearDataTable('tableSearch')">
                                <div class="invalid-feedback">Invalid Request Period</div>
                            </div>
                        </div>
                        <div class="col-sm-4 col-lg-3 col-md-3">
                            <div class="form-group">
                                <button id="btn_Search" class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search" onclick="GetSearchList();">
                                    <i class="fa fa-search mr-2"></i> Search
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Retailer Name</th>
                                    <th>Dealer Name</th>
                                    <th>Sales User Name</th>
                                    <th>Sales Area Name</th>
                                    <th>Status</th>
                                    <th class="text-right" style="width: 50px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="divContent" class="row">
    </div>


</div>

@section Scripts{
    <script src="~/tran_js/transactions_retailersauthorization.js" asp-append-version="true"></script>
}


