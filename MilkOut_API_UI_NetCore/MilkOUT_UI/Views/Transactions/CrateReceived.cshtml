@{
    ViewData["Title"] = "Crate Received from Dealer";
}
<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Crate Received from Dealer</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Transaction</a></li>
            <li class="breadcrumb-item active" aria-current="page">Crate Received from Dealer</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Crate Received from Dealer List</div>
                    <div class="card-options">
                        <a href="#" class="btn btn-primary btn-sm" onclick="ShowAddEntry('ADD','','','');"><i class="fa fa-plus mr-2"></i> Add</a>
                    </div>
                </div>
                <div class="card-body">
                    <!--SEARCH FIELDS-->
                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-4">
                            <div class="form-group">
                                <label class="form-label-search">Dealer Name</label>
                                <select id="ddlSearchDealer" class="form-control select2 w-100"
                                        required="" onchange="ClearInvalidState(this); ClearDataTable('tableSearch')">
                                    <option value="">Select Dealer Name</option>
                                </select>
                                <div class="invalid-feedback">Dealer Name must be selected</div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-4">
                            <div class="form-group">
                                <label class="form-label-search">Received Period<span class="text-red">*</span></label>
                                <input type="text" class="form-control" id="txtSearchReceivedPeriod" name="datefilter"
                                       placeholder="Received Period"
                                       maxlength="50" autocomplete="off" onkeypress="ClearDataTable('tableSearch')">
                                <div class="invalid-feedback">Invalid Received Period</div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-4">
                            <div class="form-group">
                                <button id="btn_Search" class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search" onclick="GetSearchList();">
                                    <i class="fa fa-search mr-2"></i> Search
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Dealer Name</th>
                                    <th>Received Date</th>
                                    <th>Received Quantity</th>
                                    <th>Crate Balance</th>
                                    <th class="text-right" style="width: 50px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="divContent" class="row">
    </div>


</div>

@section Scripts{
    <script src="~/tran_js/transactions_cratereceived.js" asp-append-version="true"></script>
}


