                        </tbody>
                    </table>
                </div> *@

                <div class="tab-content">
                     <div class="tab-pane active" id="tab1">
                        <div class="card">
                           <div class="card-header">
                              <div class="card-title">Complaint Progress</div>
                              <div class="card-options">
                                 <span id="lblItemCount" hidden style="display: none;"></span>
                                 <a href="#" class="btn btn-primary btn-sm mr-2" id="btn_itemsave"
                                    data-toggle="modal" onclick="ShowDetailsModal();"><i
                                    class="fa fa-plus mr-2"></i> Add</a>
                              </div>
                           </div>
                           <div class="card-body">
                              <div class="table-responsive">
                                 <table id="tableComplaintList"
                                    class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                    <thead>
                                       <tr>
                                          <th>#</th>
                                          <th>Action Date</th>
                                          <th>Action By</th>
                                          <th>Remarks</th>
                                          <th>Updated Status</th>
                                       </tr>
                                    </thead>
                                    <tbody id="tableComplaintListBody">
                                    </tbody>
                                 </table>
                              </div>
                           </div>
                        </div>
                     </div>
                  </div>
            @* </div> *@
        </div>
    </div>
</div>





<div class="modal fade" id="modelEntry" tabdocumentation="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Images</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row" id="cImages" style="height: 70vh; overflow: scroll;">

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/tran_js/transaction_complaints.js" asp-append-version="true"></script>
}
