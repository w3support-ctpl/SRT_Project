<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Complaint</div>
            <div class="card-options">
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry();">Close</a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Complaint Date</label>
                        <label id="txtEntryComplaintsDate" class="form-control"></label>
                         <span id="lblEntryId" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">User Type</label>
                        <label id="txtEntryUserType" class="form-control"></label>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">User Name</label>
                        <label id="txtEntryUserName" class="form-control"></label>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Complaint Type</label>
                        <label id="ddlEntryComplaintType" class="form-control"></label>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Complaint Status</label>
                        <label id="ddlEntryComplaintStatus" class="form-control"></label>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Open Days</label>
                        <label id="txtEntryOpenDays" class="form-control"></label>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Latitude</label>
                        <label id="txtEntryLatitude" class="form-control"></label>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Longitude</label>
                        <label id="txtEntryLongitude" class="form-control"></label>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label" style="visibility: hidden;">hi</label>
                        <div class="row gutters-xs">
                            <div class="col">

                            </div>
                            <span class="col-auto">
                                <button class="btn btn-secondary" type="button" onclick="generateGoogleMapsURL();"><i
                                        class="fa fa-map-marker"></i></button>
                                <button class="btn btn-secondary" type="button" onclick="openImages();"><i
                                        class="fa fa-camera"></i></button>
                            </span>
                        </div>
                    </div>

                </div>
            </div>
            @* <div class="row"> *@
