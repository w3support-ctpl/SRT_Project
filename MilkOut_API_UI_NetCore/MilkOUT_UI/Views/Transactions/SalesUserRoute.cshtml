@{
    ViewData["Title"] = "Sales User Route";
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Sales User Route</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Transactions</a></li>
            <li class="breadcrumb-item active" aria-current="page">Sales User Route</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Sales Person Route List</div>
                    <div class="card-options">
                        <a href="javascript:void(0);" class="btn btn-primary btn-sm" onclick="AddDealerEntry();"><i
                            class="fa fa-plus mr-2"></i> Add Dealer</a>
                        </div>
                    </div>
                    <div class="card-body">
                        <!--SEARCH FIELDS-->
                        <div class="row">
                            <div class="col-sm-4 col-md-3 col-lg-4">
                                <div class="form-group">
                                    <label class="form-label-search">Sales User<span class="text-red">*</span></label>
                                    <select id="ddlSearchSalesUser" class="form-control select2 w-100" required=""
                                            onchange="ClearInvalidState(this); ClearDataTable('tableSearch');">
                                        <option value="">Sales User Name</option>
                                    </select>
                                    <div class="invalid-feedback">Sales User must be selected</div>
                                </div>
                            </div>
                            <div class="col-sm-4 col-lg-3 col-md-3">
                                <div class="form-group">
                                    <button id="btn_Search" class="btn btn-sm btn-secondary"
                                            style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search"
                                            onclick="GetSearchList();">
                                        <i class="fa fa-search mr-2"></i> Search
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table id="tableSearch"
                                   class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                <thead>
                                    <tr>
                                        <th style="width: 20px;">#</th>
                                        <th>Route Name</th>
                                        <th>Day</th>
                                        <th>Working Status</th>
                                        <th>No of Retailers</th>
                                        <th class="text-right" style="width: 50px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="tableData">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="divContent" class="row">
        </div>


    </div>

    <div class="modal fade" id="modalEntry" tabdocumentation="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document" style="width: 85% !important;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="AddEdit">Add Dealer</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">

                    <div class="table-responsive" style="height: 500px !important;overflow: auto !important;">
                        <table id="tableEntryModal"
                               class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>


                                    <th id="thAssignedDealerheckbox" style="width: 20px;" class="text-center">
                                        <label class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input select-all checkbox"
                                                   id="selectAll" />
                                            <label for="selectAll" class="custom-control-label text-dark"></label>
                                        </label>
                                    </th>
                                    <th>Dealer Code</th>
                                    <th>Dealer Name</th>
                                    <th hidden></th>
                                </tr>
                            </thead>
                            <tbody id="tableEntryModalData">

                            </tbody>

                        </table>
                    </div>
                </div>
                <div id="divAssignedDealerFooter" class="modal-footer" style="justify-content:flex-start">

                    <button type="button" class="btn btn-primary" id="btnSaveDealer"
                            onclick="SaveDealer();">Save</button>

                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="~/tran_js/transactions_salesuserroute.js" asp-append-version="true"></script>
    }