@{
    ViewData["Title"] = "Targets";
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Targets</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Transactions</a></li>
            <li class="breadcrumb-item active" aria-current="page">Targets</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Targets List</div>
                    <div class="card-options">
                        <a href="javascript:void(0);" class="btn btn-primary btn-sm" onclick="ShowAddEntry();"><i
                                class="fa fa-plus mr-2"></i> Add</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-4 col-md-3 col-lg-4">
                            <div class="form-group">
                                <label class="form-label-search">Sales User <span class="text-red">*</span></label>
                                <select id="ddlSearchSalesUser" class="form-control select2 w-100" required=""
                                    onchange="ClearInvalidState(this); ClearDataTable('tableSearch');">
                                    <option value="">Sales User Name</option>
                                </select>
                                <div class="invalid-feedback">Sales User must be selected</div>
                            </div>
                        </div>
                        <!--
                        <div class="col-sm-4 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Financial Year <span class="text-red">*</span></label>
                                <select id="ddlSearchFinancialYear" class="form-control select2 w-100"
                                        required="" onchange="ClearInvalidState(this); ClearDataTable('tableSearch');">
                                    <option value="">Sales Financial Year</option>
                                </select>
                                <div class="invalid-feedback">Financial Year must be selected</div>
                            </div>
                        </div>
                        -->
                        <div class="col-sm-6 col-lg-4 col-md-3">
                            <button class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);"
                                type="button" title="Search" onclick="GetSearchList(this);">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Month & Year</th>
                                    @* <th>Product Type</th>
                                    <th>Product Group</th>
                                    <th>Product Name</th>
                                    <th>UOM</th> *@
                                    <th>Dealer Name</th>
                                    <th>Quantity (Kg)</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="divContent" class="row">
    </div>
</div>



<!--MODAL Edit Targets-->
<div class="modal fade" id="modelTargets" tabdocumentation="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add/Edit Targets</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @* <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="form-group">
                            <label class="form-label">Month & Year <span class="text-red">*</span></label>
                            <input type="month" id="txtEntryMonthYear" class="form-control"
                                onchange="ClearInvalidState(this);" onkeydown="return false" />
                            <div class="invalid-feedback">Month & Year can't be blank.</div>
                        </div>
                    </div>
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="form-group">
                            <label class="form-label">Dealer Name <span class="text-red">*</span></label>
                            <select id="ddlEntryDealer" class="form-control select2 w-100" required=""
                                onchange="ClearInvalidState(this); changeproduct();">
                                <option value="">Select Dealer Name</option>
                            </select>
                            <span id="lblEntryId" hidden style="display: none;"></span>
                            <span id="lblAction" hidden style="display: none;"></span>
                            <div class="invalid-feedback">Dealer Name must be selected.</div>
                        </div>
                    </div> *@
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="form-group">
                            <label class="form-label">Product Group <span class="text-red">*</span></label>
                            <select id="ddlEntryProductGroup" class="form-control select2 w-100" required=""
                                onchange="ClearInvalidState(this);GetProductList();">
                                <option value="">Select Product Group</option>
                            </select>
                            <span id="lblEntryIdItem" hidden style="display: none;"></span>
                            <span id="lblActionItem" hidden style="display: none;"></span>
                            <div class="invalid-feedback">Product Group must be selected.</div>
                        </div>
                    </div>
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="form-group">
                            <label class="form-label">Product Name <span class="text-red">*</span></label>
                            <select id="ddlModalItemCode" class="form-control select2 w-100" required=""
                                onchange="ClearInvalidState(this);GetProductUOMtList();">
                                <option value="">Select Product</option>
                            </select>
                            <div class="invalid-feedback">Product must be selected.</div>
                        </div>
                    </div>

                    @* <div class="row"> *@
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalUOM" class="form-control-label">Select UOM <span
                                    class="text-red">*</span></label>
                            <select id="txtModalUOM" class="form-control select2 w-100" required=""
                                onchange="ClearInvalidState(this);" disabled>
                                <option value="">Select UOM</option>

                            </select>
                            <div class="invalid-feedback">Invalid UOM</div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="form-group">
                            <label class="form-label">Quantity <span class="text-red">*</span></label>
                            <input type="number" id="txtEntryQuantityItem" class="form-control"
                                placeholder="Enter Quantity" maxlength="200" autocomplete="off"
                                onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Invalid Quantity.</div>
                        </div>
                    </div>
                    @* </div> *@
                </div>
            </div>
            <div class="modal-footer" style="justify-content:flex-start">
                <button type="button" class="btn btn-primary" id="btn_Save_Item"
                    onclick="SaveEntryItem();">Save</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/tran_js/transactions_targets.js" asp-append-version="true"></script>
}
