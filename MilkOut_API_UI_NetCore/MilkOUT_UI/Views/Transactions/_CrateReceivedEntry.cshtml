<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Crate Received from Dealer</div>
            <div class="card-options">

                <a id="btn_Save" style="display:none;" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-lg-4 col-md-3 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Dealer Name<span class="text-red">*</span></label>
                        <select id="ddlEntryDealer" class="form-control select2 w-100"
                                required="" onchange="ClearInvalidState(this);" disabled>
                            <option value="">Select Dealer Name</option>
                        </select>
                        <div class="invalid-feedback">Dealer Name must be selected</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>      
                    </div>
                </div>
                <div class="col-lg-4 col-md-3 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Received On</label>
                        <input type="date" id="txtEntryReceivedOn" class="form-control" disabled>
                        <div class="invalid-feedback">Received On can't be blank</div>
                        
                    </div>
                </div>
                @* <div class="col-lg-4 col-md-3 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Quantity<span class="text-red">*</span></label>
                        <input type="text" id="txtEntryQuantity" class="form-control" placeholder="Enter Quantity" maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this)">
                        <div class="invalid-feedback">Quantity can't be blank.</div>
                    </div>
                </div> *@
            </div>
            <div class="row">
                <div class="col-12">
                    <h5 class="mb-4 font-weight-bold text-secondary">Material List</h5>
                    <div class="table-responsive">
                        <table id="tableEntryList" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Material Name</th>
                                    <th>Quantity</th>
                                    <th class="col-2">Good</th>
                                    <th class="col-2">Broken</th>
                                    <th class="col-2">Third Party</th>
                                    <th hidden></th>
                                </tr>
                            </thead>
                            <tbody id="tableEntry">
                            </tbody>
                        </table>
                    </div>
                </div>
                
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/tran_js/transactions_cratereceivefromdealer.js" asp-append-version="true"></script>
}
