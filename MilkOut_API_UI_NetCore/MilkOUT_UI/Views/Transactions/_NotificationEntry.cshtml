
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Notification Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry()"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <div class="row">
                <span id="lblEntryId" hidden style="display: none;"></span>
                <span id="lblAction" hidden style="display: none;"></span>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Notification For <span class="text-red">*</span></label>
                        <select id="ddlEntryNotificationFor" class="form-control select2 w-100" required="" onchange="ClearInvalidState(this);">
                            <option value="">Select Notification For</option>

                        </select>
                        <div class="invalid-feedback">Notification For must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Notification Type <span class="text-red">*</span></label>
                        <select id="ddlEntryNotificationType" class="form-control select2 w-100" required="" onchange="ClearInvalidState(this);">
                            <option value="">Select Notification Type</option>

                        </select>
                        <div class="invalid-feedback">Notification Type must be selected.</div>
                    </div>
                </div> 
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Schedule Date <span class="text-red">*</span></label>
                        <input type="date" id="txtEntryScheduleDate" class="form-control" placeholder="Enter Schedule Date" maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Schedule Date.</div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Subject <span class="text-red">*</span></label>
                        <input type="text" id="txtEntrySubject" class="form-control" placeholder="Enter Subject" 
                        maxlength="200" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Subject.</div>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Message <span class="text-red">*</span></label>
                        <textarea id="txtEntryMessage" class="form-control" placeholder="Enter Message" 
                        autocomplete="off" onkeypress="ClearInvalidState(this);" rows="5"></textarea>
                        <div class="invalid-feedback">Invalid Message.</div>
                    </div>
                </div>
            </div>
           
        </div>
        <div class="card-footer text-right" id="divFooterDelete">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry('');"><i class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</div>


<div id="divContent" class="row">
</div>


