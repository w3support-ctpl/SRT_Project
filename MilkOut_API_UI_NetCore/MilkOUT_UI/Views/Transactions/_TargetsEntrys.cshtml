<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Targets Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <a href="#" id="btn_Save" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();">
                    <i class="fa fa-save mr-2"></i> Save</a>

                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!--ENTRY SECTION-->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Month & Year <span class="text-red">*</span></label>
                        <input type="month" id="txtEntryMonthYear" class="form-control"
                            onchange="ClearInvalidState(this);" onkeydown="return false" />
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                        <div class="invalid-feedback">Month & Year can't be blank.</div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Dealer Name <span class="text-red">*</span></label>
                        <select id="ddlEntryDealer" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this)">
                            <option value="">Select Dealer Name</option>
                        </select>
                        <div class="invalid-feedback">Dealer Name must be selected.</div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Quantity (Kg) <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryQuantity" class="form-control" maxlength="50" autocomplete="off"
                            onkeypress="ClearInvalidState(this);" disabled>
                        <div class="invalid-feedback">Quantity can't be blank.</div>
                    </div>
                </div>

            </div>
            <div class="row" id="divTabs">
                <div class="col-12">
                    <!--
                    <div class="panel panel-primary">
                        <div>
                            <div class="user-tabs mb-4">
                                <ul class="nav panel-tabs">
                                    <li><a href="#tab1" class="active" data-toggle="tab" onclick="GetPaymentSettingsList();">Payment Settings</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    -->
                    <div class="tab-content">
                        <div class="tab-pane active" id="tab1">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Targets List</div>
                                    <div class="card-options">
                                        <a href="javascript:void(0);" class="btn btn-primary btn-sm mr-2"
                                            onclick="OpenModal('Add','');" id="OpenModal"><i
                                                class="fa fa-plus mr-2"></i> Add</a>
                                    </div>
                                </div>
                                <div id="divItemSuccess" class="card-alert alert alert-success mb-0"
                                    style="display: none;">
                                    Save action was successful
                                </div>
                                <div id="divItemError" class="card-alert alert alert-danger mb-0"
                                    style="display: none;">
                                    Save action failed
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableList"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 50px;">#</th>
                                                    <th>Product Type</th>
                                                    <th>Product Group</th>
                                                    <th>Product Name</th>
                                                    <th>UOM</th>
                                                    <th>Quantity (Kg)</th>
                                                    <th class="text-right" style="width: 100px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntry">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- FOOTER SECTION -->
        <div id="divFooterDelete" class="card-footer text-right">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i
                        class="fa fa-trash"></i></button>

            </div>
        </div>
    </div>
</div>
