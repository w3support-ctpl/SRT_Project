                        <div class="invalid-feedback">Invalid Pan Number.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Shop Latitude</label>
                        <input type="text" id="txtEntryShopLatitude" class="form-control"
                               placeholder="Enter Shop Latitude " maxlength="10" autocomplete="off"
                               onkeypress="ClearInvalidState(this);" disabled>
                        <div class="invalid-feedback">Invalid Shop Latitude.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Shop Longitude</label>
                        <input type="text" id="txtEntryShopLongitude" class="form-control"
                               placeholder="Enter Shop Longitude" maxlength="10" autocomplete="off"
                               onkeypress="ClearInvalidState(this);" disabled>
                        <div class="invalid-feedback">Invalid Shop Longitude.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">FSSAI License No <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryFSSAILicenseNo" class="form-control"
                               placeholder="Enter FSSAI License No" maxlength="14" autocomplete="off"
                               onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid FSSAI License No.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">FSSAI License Validity Date <span class="text-red">*</span></label>
                        <input type="date" id="txtEntryFSSAIValidityDate" class="form-control" value=""
                               onchange="ClearInvalidState(this);" onkeydown="return false">
                        <div class="invalid-feedback">Invalid FSSAI Validity Date</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">GST No <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryGSTNo" class="form-control"
                               placeholder="Enter GST No" maxlength="20" autocomplete="off"
                               onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid GST No.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Agreement Validity Period <span class="text-red">*</span></label>
                        <input type="text" name="datefilter" id="txtEntryAgreementValidityPeriod"
                               class="form-control" autocomplete="off" value="" placeholder="">
                        <div class="invalid-feedback">Invalid Agreement Validity Period</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Security Deposit Amount </label>
                        <input type="text" id="txtEntrySecurityDepositAmount" class="form-control"
                               placeholder="" maxlength="50" autocomplete="off"
                               onkeypress="ClearInvalidState(this);" disabled>
                        <div class="invalid-feedback">Invalid Security Deposit Amount.</div>
                    </div>
                </div>
                <!-- nesting this checkbox to avoid it getting selected by accident even if the cursor isn't near the element-->
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Agreement Done <span class="text-red">*</span></label>
                                <label class="custom-control custom-checkbox mt-3">
                                    <input type="checkbox" id="chkAgreementDoneFlag" class="custom-control-input" value="1">
                                    <label for="chkAgreementDoneFlag" class="custom-control-label text-dark">Yes</label>
                                </label>
                                <div class="invalid-feedback">Invalid Input</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

