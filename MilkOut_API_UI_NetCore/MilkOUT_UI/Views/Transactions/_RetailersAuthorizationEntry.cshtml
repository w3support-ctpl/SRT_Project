<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Retailer Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();" style="display:none;"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Approval Status <span class="text-red">*</span></label>
                        <select id="ddlEntryApprovalStatus" class="form-control select2 w-100"
                                required="" onchange="ClearInvalidState(this);">
                            <option value="">Select Status</option>
                        </select>
                        <div class="invalid-feedback">Approval Status must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-9 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Remarks <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryRemarks" class="form-control" placeholder="Enter Remarks" maxlength="200" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Remarks.</div>
                    </div>
                </div>
            </div>
            <h5 class="mb-4 font-weight-bold text-secondary">Retailer Details</h5>
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Retailer Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryRetailerName" class="form-control"
                               placeholder="Enter Retailer Name" maxlength="50" autocomplete="off"
                               onkeypress="ClearInvalidState(this);">
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                        <div class="invalid-feedback">Invalid Retailer Name.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Sales Group <span class="text-red">*</span></label>
                        <select id="ddlEntrySalesArea" class="form-control select2 w-100" required="" onchange="ClearInvalidState(this);">
                            <option value="">Select Sales Group</option>

                        </select>
                        <div class="invalid-feedback">Sales Group must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Dealer Name <span class="text-red">*</span></label>
                        <select id="ddlEntryDealerName" class="form-control select2 w-100" required="" onchange="ClearInvalidState(this);">
                            <option value="">Select Dealer Name</option>

                        </select>
                        <div class="invalid-feedback">Dealer Name must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Sales User <span class="text-red">*</span></label>
                        <select id="ddlEntrySalesUser" class="form-control select2 w-100"
                                required="" onchange="ClearInvalidState(this);">
                            <option value="">Select Sales Area</option>
                        </select>
                        <div class="invalid-feedback">Sales Area must be selected</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Contact Person<span class="text-red">*</span></label>
                        <input type="text" id="txtEntryContactPersonName" class="form-control" placeholder="Enter Contact Person Name" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Contact Person.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Mobile No <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryMobileNo" class="form-control" placeholder="Enter Mobile No" maxlength="10" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Mobile Number.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Email Id <span class="text-red"></span></label>
                        <input type="text" id="txtEntryEmailId" class="form-control" placeholder="Enter Email Id" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Email Id.</div>
                    </div>
                </div>
            </div>
            <!--ADDRESS DETAILS-->
            <h5 class="mb-4 font-weight-bold text-secondary">Address Details</h5>
            <div class="row">
                <div class="col-lg-6 col-md-8 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Address Line 1 <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryAddress1" class="form-control" placeholder="Enter Address Line 1" maxlength="100" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Address Line 1.</div>

                    </div>
                </div>
                <div class="col-lg-6 col-md-8 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Address Line 2 <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryAddress2" class="form-control" placeholder="Enter Address Line 2" maxlength="100" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Address Line 2.</div>

                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">State <span class="text-red">*</span></label>
                        <select id="ddlEntryState" class="form-control select2 w-100"
                                required="" onchange="ClearInvalidState(this); GetDistrict()">
                            <option value="">Select State</option>

                        </select>
                        <div class="invalid-feedback">State must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">District <span class="text-red">*</span></label>
                        <select id="ddlEntryDistrict" class="form-control select2 w-100"
                                required="" onchange="ClearInvalidState(this); GetTaluka();">
                            <option value="">Select District</option>

                        </select>
                        <div class="invalid-feedback">District must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">City/Taluka <span class="text-red">*</span></label>
                        <select id="ddlEntryTaluka" class="form-control select2 w-100"
                                required="" onchange="ClearInvalidState(this);">
                            <option value="">Select City/Taluka</option>
                            <option value="1">Palava</option>

                        </select>
                        <div class="invalid-feedback">City/Taluka must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Pin Code <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryPinCode" class="form-control" placeholder="Enter Pin code" maxlength="6" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Pin Code.</div>
                    </div>
                </div>

            </div>



            <!--BANK DETAILS-->
            <h5 class="mb-4 font-weight-bold text-secondary">Bank Details</h5>
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Bank Name </label>
                        <select id="ddlEntryBankName" class="form-control select2 w-100"
                                required="" onchange="GetBranch(); ClearInvalidState(this);">
                            <option value="">Select Bank Name</option>
                        </select>
                        <div class="invalid-feedback">Bank Name must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Branch Name </label>
                        <select id="ddlEntryBranchName" class="form-control select2 w-100"
                                required="" onchange="SetIFSCCode(''); ClearInvalidState(this);">
                            <option value="">Select Branch Name</option>
                        </select>
                        <div class="invalid-feedback">Branch Name must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Account Name </label>
                        <input type="text" id="txtEntryAccountName" class="form-control"
                               placeholder="Enter Account Name" maxlength="50" autocomplete="off"
                               onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Account Name.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Account No </label>
                        <input type="text" id="txtEntryAccountNo" class="form-control"
                               placeholder="Enter Account No" maxlength="20" autocomplete="off"
                               onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Account No.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">IFSC Code</label>
                        <label id="txtEntryIFSCCode" class="form-control"> </label>
                        <div class="invalid-feedback">Invalid IFSC Code.</div>
                    </div>
                </div>
            </div>



            <h5 class="mb-4 font-weight-bold text-secondary">Other Details</h5>
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Shop License No </label>
                        <input type="text" id="txtEntryShopLicenseNo" class="form-control" placeholder="Enter Shop License No" maxlength="10" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Shop License Number.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">PAN No </label>
