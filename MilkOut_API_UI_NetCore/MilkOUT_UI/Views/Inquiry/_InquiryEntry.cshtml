<div class="modal fade" id="modelEntryInquiryItem" tabdocumentation="-1" role="dialog" aria-hidden="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="AddEditRoute">Add Item</h5>
                <span hidden id="lblAction"></span>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="ddlModalProductGroup" class="form-control-label">Select Product Group <span
                            class="text-red">*</span></label>
                    <select id="ddlModalProductGroup" class="form-control select2 w-100" required=""
                        onchange="GetProductList();ClearInvalidState(this);">
                        <option value="">Select Product Group</option>

                    </select>
                    <div class="invalid-feedback">Invalid Product Group</div>
                </div>

                <div class="form-group">
                    <label for="txtModalItemCode" class="form-control-label">Select Product <span
                            class="text-red">*</span></label>
                    <select id="ddlModalItemCode" class="form-control select2 w-100" required=""
                        onchange="OnChnageSelectSalesUser();GetProductUOMtList();ClearInvalidState(this);GetRate();">
                        <option value="">Select Product</option>

                    </select>
                    <span id="lblItemEntryId" hidden style="display: none;"></span>
                    <span id="lblItemAction" hidden style="display: none;"></span>
                    <div class="invalid-feedback">Invalid Item Code</div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalUOM" class="form-control-label">Select UOM <span
                                    class="text-red">*</span></label>
                            <select id="txtModalUOM" class="form-control select2 w-100" required=""
                                onchange="ClearInvalidState(this);">
                                <option value="">Select UOM</option>

                            </select>
                            <div class="invalid-feedback">Invalid UOM</div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalQuantity" class="form-control-label">Quantity <span
                                    class="text-red">*</span></label>
                            <input type="number" class="form-control" id="txtModalQuantity" placeholder="Enter Quantity"
                                autocomplete="off" onkeyup="ChangePrice();" onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Invalid Quantity</div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalRate" class="form-control-label">Rate
                            </label>
                            <input type="number" class="form-control" id="txtModalRate" placeholder="Enter Rate"
                                maxlength="50" autocomplete="off" onkeyup="ChangePrice();"
                                onkeypress="ClearInvalidState(this);">

                        </div>
                    </div>


                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalPrice" class="form-control-label">Price </label>
                            <input type="text" class="form-control" id="txtModalPrice" disabled
                                placeholder="Enter Price" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-4 col-md-4 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalSAPRate" class="form-control-label">SAP Rate
                            </label>
                            <input type="text" class="form-control" id="txtModalSAPRate" placeholder="Enter Rate"
                                maxlength="50" autocomplete="off" disabled onkeypress="ClearInvalidState(this);">

                        </div>
                    </div>


                    <div class="col-lg-4 col-md-4 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalSAPUOM" class="form-control-label">SAP Unit</label>
                            <input type="text" class="form-control" id="txtModalSAPUOM" disabled
                                placeholder="Enter Price" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4 col-sm-12">
                        <div class="form-group">
                            <label for="txtModalSAPQuantity" class="form-control-label">SAP Quantity</label>
                            <input type="text" class="form-control" id="txtModalSAPQuantity" disabled
                                placeholder="Enter Quantity" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="form-group">
                            <label class="form-label">Note </label>

                            <textarea id="txtEntryNote" class="form-control" placeholder="Enter Note" rows="1"
                                autocomplete="off" onkeypress="ClearInvalidState(this)"></textarea>
                            <div class="invalid-feedback"> Note can't be blank.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="justify-content:flex-end">
                <button type="button" class="btn btn-primary" id="btn_Save_Item"
                    onclick="SaveItemEntry();">Save</button>
            </div>
        </div>
    </div>
</div>
