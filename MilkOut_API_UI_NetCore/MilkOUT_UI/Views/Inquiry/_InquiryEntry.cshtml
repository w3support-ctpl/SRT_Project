                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Inquiry Number</label>
                        <input type="text" class="form-control" id="txtEntryInquiryNo" disabled placeholder="Inquiry No"
                            maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Inquiry No</div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3 col-lg-3">
                    <div class="form-group">
                        <label class="form-label">Inquiry Status <span class="text-red">*</span></label>
                        <select id="ddlEntryInquiryStatus" class="form-control select2 w-100" required="" disabled
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Inquiry Status</option>

                        </select>
                        <div class="invalid-feedback">Invalid Inquiry Status</div>
                    </div>
                </div>

                <div class="col-sm-6 col-md-3 col-lg-3">
                    <div class="form-group">
                        <label class="form-label">Retailer Name </label>
                        <select id="ddlEntryRetailerName" class="form-control select2 w-100"
                            onchange="ClearInvalidState(this);GetSalesUser();">
                            <option value="">Select Retailer Name</option>

                        </select>
                        <div class="invalid-feedback">Select Retailer Name</div>
                    </div>
                </div>

                <div class="col-sm-6 col-md-3 col-lg-3">
                    <div class="form-group">
                        <label class="form-label">Sales User<span class="text-red">*</span></label>
                        <select id="ddlEntrySalesUser" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Sales User</option>

                        </select>
                        <div class="invalid-feedback">Select Sales User</div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-6 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Customer Reference </label>
                        <input type="text" class="form-control" id="txtEntryCustReference"
                            placeholder="Enter Customer Reference" maxlength="100" autocomplete="off"
                            onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Cust Reference</div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Sales Note </label>
                        <input type="text" class="form-control" id="txtEntryInquirySalesAreaNote"
                            placeholder="Enter Sales Note" maxlength="100" autocomplete="off"
                            onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Sales Note</div>
                    </div>
                </div>
            </div>
            <div class="row" id="divTabs">
                <div class="col-12">
                    <div class="panel panel-primary">
                        <div>
                            <div class="user-tabs mb-4">
