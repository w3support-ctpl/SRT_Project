                                                    <th>UOM</th>
                                                    <th>Price</th>
                                                    <th class="text-right" style="width: 120px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntryItem">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
