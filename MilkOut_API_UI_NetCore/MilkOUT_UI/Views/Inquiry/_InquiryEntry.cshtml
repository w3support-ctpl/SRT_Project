<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Modify Inquiry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <!--<a href="javascript:void(0);" class="btn btn-primary btn-sm" onclick="ShowViewEntry()">View Flow</a>&nbsp;&nbsp;-->
                <a id="btn_Save" href="javascript:void(0);" class="btn btn-primary btn-sm mr-2"
                    onclick="SaveEntry();"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0);" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <div class="row">
                <span id="lblEntryId" hidden style="display: none;"></span>
                <span id="lblAction" hidden style="display: none;"></span>
                <span id="lblDealerId" hidden style="display: none;"></span>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Inquiry Date</label>
                        <input type="text" class="form-control" id="txtEntryInquiryDate" placeholder="" disabled
                            maxlength="50" autocomplete="off" onkeypress="ClearDataTable('tableEntry')" />
                        <div class="invalid-feedback">Invalid Inquiry Date</div>
                    </div>
                </div>

