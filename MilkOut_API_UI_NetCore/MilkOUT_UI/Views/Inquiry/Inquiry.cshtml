@{
    ViewData["Title"] = "Inquiry";
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Inquiry</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Primary</a></li>
            <li class="breadcrumb-item active" aria-current="page">Inquiry</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Inquiry List</div>
                    <div class="card-options">
                        <a href="javascript:void(0);" id="btn_Add" class="btn btn-primary btn-sm"
                            onclick="ShowAddEntry();"><i class="fa fa-plus mr-2"></i> Add</a>
                    </div>
                </div>
                <div class="card-body">
                    <!--SEARCH FIELDS-->
                    <div class="row">
                        <div class="col-lg-4 col-md-3 col-sm-12">
                            <div class="form-group">
                                <label class="form-label-search">Dealer Name  <span class="text-red">*</span></label>
                                <select id="ddlSearchDealerName" class="form-control select2 w-100" required=""
                                    onchange="ClearDataTable('tableSearch'); ClearInvalidState(this);">
                                    <option value="">Select Dealer Name</option>

                                </select>
                                <div class="invalid-feedback">Please Select Dealer Name</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Inquiry Date <span class="text-red">*</span></label>
                                <input type="text" class="form-control" id="txtSearchInquiryDate" name="datefilter"
                                    placeholder="Inquiry Date" maxlength="50" autocomplete="off"
                                    onkeypress="ClearDataTable('tableSearch')">
                                <div class="invalid-feedback">Invalid Inquiry Date</div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button id="btn_Search" class="btn btn-sm btn-secondary"
                                style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search"
                                onclick="GetSearchList();">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Inquiry No</th>
                                    <th>Dealer Name</th>
                                    <th>Retailer Name</th>
                                    <th>Sales User</th>
                                    <th>Inquiry Date</th>
                                    <th>Status</th>
                                    <!--<th>Customer Reference</th>
                                    <th>Amount</th>
                                    <th>Currency</th>-->
                                    <th class="text-right" style="width: 50px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="divContent" class="row">
    </div>

</div>

@section Scripts {
    <script src="~/tran_js/inquiry.js" asp-append-version="true"></script>
}
