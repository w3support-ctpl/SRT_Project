@{
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowEditButton = false;
    bool ShowDelButton = false;
    if (AccessString.Substring(2, 1) == "1")
    {
        ShowEditButton = true;
    }
    if (AccessString.Substring(3, 1) == "1")
    {
        ShowDelButton = true;
    }
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">User Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                @if (ShowEditButton == true)
                {
                    <a href="#" id="btn_Save" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();"><i
                        class="fa fa-save mr-2"></i> Save</a>
                }
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!--ENTRY SECTION-->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Employee Id <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryEmployeeId" class="form-control" placeholder="Enter Employee Id"
                            maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Employee Id can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">User Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryUserName" class="form-control" placeholder="Enter User Name"
                            maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">User Name can't be blank.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Joining Date <span class="text-red">*</span></label>
                        <input type="date" id="txtEntryJoiningDate" class="form-control"
                            placeholder="Enter Joining Date" maxlength="50" autocomplete="off"
                            onchange="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Joining Date</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Mobile No <span class="text-red">*</span></label>
                        <input type="tel" id="txtEntryMobileNo" class="form-control" placeholder="Enter Mobile No"
                            maxlength="10" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Mobile No</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">User Role <span class="text-red">*</span></label>
                        <select id="ddlEntryUserRole" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select User Role</option>
                        </select>
                        <div class="invalid-feedback">User Role must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Email ID <span class="text-red">*</span></label>
                        <input type="email" id="txtEntryEmailID" class="form-control" placeholder="Enter Email ID"
                            maxlength="100" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Email Id</div>
                    </div>
                </div>
            </div>
            <!--OTHER DETAILS-->
            <h5 class="mb-4 font-weight-bold text-secondary">Other Details</h5>
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Pan No </label>
                        <input type="text" id="txtEntryPanNo" class="form-control" placeholder="Enter Pan No"
                            maxlength="10" autocomplete="off" onkeypress="ClearInvalidState(this);" pattern="[A-Z0-9]*">
                        <div class="invalid-feedback">Invalid Pan No</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Aadhar No </label>
                        <input type="tel" id="txtEntryAadharNo" class="form-control" placeholder="Enter Aadhar No"
                            maxlength="12" autocomplete="off" onkeypress="ClearInvalidState(this);" pattern="[0-9]*">
                        <div class="invalid-feedback">Invalid Aadhar No</div>
                    </div>
                </div>
            </div>
        </div>
        <!-- FOOTER SECTION -->
        <div id="divFooterDelete" class="card-footer text-right">
            <div class="d-flex">
                @if (ShowDelButton == true)
                {
                    <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i
                        class="fa fa-trash"></i></button>
                }
            </div>
        </div>
    </div>
</div>