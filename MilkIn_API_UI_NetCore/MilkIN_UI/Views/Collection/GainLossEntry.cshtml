@{
    ViewData["Title"] = "Gain Loss Entry";
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Gain Loss Entry</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Milk Collection</a></li>
            <li class="breadcrumb-item active" aria-current="page">Gain Loss Entry</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Gain Loss Entry List</div>
                    <!--
                    <div class="card-options">
                        <a href="#" class="btn btn-primary btn-sm" onclick="ShowAddEntry();"><i class="fa fa-plus mr-2"></i> Add</a>
                    </div>
                    -->
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-3 col-md-3 form-group">
                            <label class="form-label-search" for="txtSearchDuration">Entry Period </label>
                            <input type="text" class="form-control" name="datefilter" id="txtSearchDuration" onchange="ClearDataTable('tableSearch')"
                                   autocomplete="off" />
                        </div>
                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search" onclick="GetSearchList(this);">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Vehicle No</th>
                                    <th>Route Name</th>
                                    <th>Shift</th>
                                    <th>Time</th>
                                    <th>Net Weight</th>
                                    <th>Vehicle Type</th>
                                    <th>Status</th>
                                    <th class="text-right" style="width: 50px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divContent" class="row">
    </div>


</div>

@section Scripts{
    <script src="~/tran_js/collection_gain_loss_entry.js" asp-append-version="true"></script>
}
