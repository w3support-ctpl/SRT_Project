<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title" id="divMCCEntryCardTitle">Milk Collection <span class="lblbmcmcc"></span> Entry
            </div>
            <div class="card-options">
                <a href="javascript:void(0);" class="btn btn-primary btn-sm mr-2" onclick="SaveTruckMCCEntry(this);"
                    id="btn_Save_MCC_Entry" hidden><i class="fa fa-save mr-2"></i> Collect</a>
                <a href="javascript:void(0);" class="btn btn-sm btn-link" onclick="CloseTruckMCCEntry();">Close</a>
            </div>
        </div>



        <!----    ----    ----    ----    Section - Success and Error Message for Data Entry    ----    ----    ----    ---->

        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>




        <div class="card-body">
            <!----    ----    ----    ----    Section - Input fields - MilkCollection & BMC Details    ----    ----    ----    ---->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Vehicle No</label>
                        <input type="text" id="txtMCCEntryVehicleNo" class="form-control" placeholder="" maxlength="50"
                            autocomplete="off" disabled>
                        <span id="lblMCCEntryAction" hidden></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Route Name</label>
                        <input type="text" id="txtMCCEntryRouteName" class="form-control" placeholder="" maxlength="50"
                            autocomplete="off" disabled>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Shift</label>
                        <input type="text" id="txtMCCEntryShift" class="form-control" placeholder="" maxlength="50"
                            autocomplete="off" disabled>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Time</label>
                        <input type="text" id="txtMCCEntryTime" class="form-control" placeholder="" maxlength="50"
                            autocomplete="off" disabled>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label"><span class="lblbmcmcc"></span> Name</label>
                        <input type="text" id="txtMCCEntryMCCName" class="form-control" placeholder=""
                            autocomplete="off" disabled>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Collection Date</label>
                        <input type="date" id="txtMCCEntryCollectionDate" class="form-control"
                            placeholder="Enter Collection Date" autocomplete="off" disabled>
                    </div>
                </div>
            </div>



            <!----    ----    ----    ----    Table - Details Entered by BMC Agent    ----    ----    ----    ---->

            <div class="card">
                <div class="card-header">
                    <div class="card-title">Details Entered by <span class="lblbmcmcc"></span> Agent</div>

                </div>
                <div class="card-body">


                    <div class="table-responsive">
                        <table id="tableMCCAgentEntryList"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th hidden></th>
                                    <th hidden></th>
                                    <th>Milk Type</th>
                                    <th>Milk Status</th>
                                    @* <th>Weight</th> *@
                                    <th>Quantity (ltr)</th>
                                    <th>FAT</th>
                                    <th>SNF</th>
                                    <th>Total Cans</th>
                                    <th hidden></th>
                                </tr>
                            </thead>
                            <tbody id="tableMCCAgentEntryData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>



            <!----    ----    ----    ----    Table - Milk Quantity at Dairy    ----    ----    ----    ---->

            <div class="card" id="divTruckQuantityList">
                <div class="card-header">
                    <div class="card-title">Quantity at Dairy</div>
                    <div class="card-options">
                        <a href="javascript:void(0);" class="btn btn-primary btn-sm mr-2" id="btnTruckRefresh"
                            onclick="OpenTruckRefresh();"><i class="fa fa-repeat mr-2"></i> Refresh</a>
                        <a href="javascript:void(0);" class="btn btn-primary btn-sm mr-2" id="btnTruckAddQuantity"
                            onclick="OpenTruckQuantityModal('Add','');"><i class="fa fa-plus mr-2"></i> Add</a>
                    </div>
                </div>
                <div class="card-alert alert alert-success mb-0 divItemSuccess" style="display: none;">
                    Save action was successful
                </div>
                <div class="card-alert alert alert-danger mb-0 divItemError" style="display: none;">
                    Save action failed
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tableTruckMilkQuantityList"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    @* <th>Batch Id</th> *@
                                    <th>Milk Type</th>
                                    <th>Milk Status</th>
                                    <th>Quantity (kg)</th>
                                    <th>Quantity (ltr)</th>
                                    <th>Cans</th>
                                    <th>Time</th>
                                    <th class="text-right" style="width: 50px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableTruckEntryQuantity">
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>



            <!----    ----    ----    ----    Table - Milk Quality at Dairy    ----    ----    ----    ---->

            <div class="card" id="divTruckQualityList">
                <div class="card-header">
                    <div class="card-title">Quality at Dairy</div>
                    <div class="card-options">
                        @* <a href="javascript:void(0);" class="btn btn-primary btn-sm mr-2" id="btnTruckAddQuality"
                        onclick="OpenTruckQualityModal('Add','');"><i class="fa fa-plus mr-2"></i> Add</a> *@
                    </div>
                </div>
                <div class="card-alert alert alert-success mb-0 divItemSuccess" style="display: none;">
                    Save action was successful
                </div>
                <div class="card-alert alert alert-danger mb-0 divItemError" style="display: none;">
                    Save action failed
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tableTruckMilkQualityList"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    @* <th>Batch Id</th> *@
                                    <th>Sample No</th>
                                    <th>Milk Status</th>
                                    <th>FAT</th>
                                    <th>SNF</th>
                                    <th hidden></th>
                                    @* <th class="text-right" style="width: 50px;">Action</th> *@
                                </tr>
                            </thead>
                            <tbody id="tableTruckEntryQuality">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!----    ----    ----    ----    Modal - Milk Quantity at Dairy    ----    ----    ----    ---->

<div class="modal fade" id="modelEntryTruckQuantityMilkCollection" tabdocumentation="-1" role="dialog"
    aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="AddEditTruckQuantityMilkCollection"></h5>
                <span hidden id="lblActionTruckQuantity"></span>
                <span hidden id="lblTruckQuantityId"></span>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"
                    onclick="ResetInputFields();">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @* <div class="col-6" id="ddlEntryTruckQuantityBatchIdCheck">
                    <div class="form-group">
                    <label class="form-label">Batch No <span class="text-red">*</span></label>
                    <select id="ddlEntryTruckQuantityBatchId" class="form-control select2 w-100" required=""
                    onchange="ClearInvalidState(this);">
                    <option value="">Select Batch No</option>
                    </select>
                    <div class="invalid-feedback">Batch No must be selected.</div>
                    </div>
                    </div> *@
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Milk Type <span class="text-red">*</span></label>
                            <select id="ddlEntryTruckQuantityMilkType" class="form-control select2 w-100" required=""
                                onchange="ClearInvalidState(this);">
                                <option value="">Select Milk Type</option>
                            </select>
                            <div class="invalid-feedback">Milk Status must be selected.</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Milk Status <span class="text-red">*</span></label>
                            <select id="ddlEntryTruckQuantityMilkStatus" class="form-control select2 w-100" required=""
                                onchange="ClearInvalidState(this);onChangeMilkType('Truck')">
                                <option value="">Select Milk Status</option>
                            </select>
                            <div class="invalid-feedback">Milk Status must be selected.</div>
                        </div>
                    </div>
                    <div class="col-6">

                        <div class="form-group">
                            <label class="form-label">Quantity (KG) <span class="text-red">*</span></label>
                            <div class="row gutters-xs">
                                <div class="col">
                                    <input type="text" id="txtEntryTruckQuantityWeight" class="form-control"
                                        placeholder="Enter Weight" maxlength="50" autocomplete="off"
                                        onchange="ClearInvalidState(this);">
                                </div>

                                <span class="col-auto">
                                    <button class="btn btn-primary" type="button"
                                        onclick="GetMachineData('Truck','Tare')"><i
                                            class="fa fa-balance-scale"></i></button>
                                </span>
                                <div class="invalid-feedback">Weight can't be blank.</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Cans <span class="text-red">*</span></label>
                            <input type="text" id="txtEntryTruckQuantityCans" class="form-control"
                                placeholder="Enter Cans" maxlength="50" autocomplete="off"
                                onchange="ClearInvalidState(this);">
                            <div class="invalid-feedback">Cans can't be blank.</div>
                        </div>
                    </div>
                    <div class="col-12" id="divTruckReasons">
                        <div class="form-group">
                            <label class="form-label">Reasons</label>
                            <textarea id="txtEntryTruckReasons" class="form-control" name="example-textarea-input"
                                rows="4" placeholder="Reasons.." onchange="ClearInvalidState(this);"></textarea>
                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer" style="justify-content:flex-start">
                <button type="button" class="btn btn-primary" id="btnTruckQuantitySave"
                    onclick="SaveTruckQuantity();">Save</button>
            </div>
        </div>
    </div>
</div>



<!----    ----    ----    ----    Modal - Milk Quality at Dairy    ----    ----    ----    ---->

<div class="modal fade" id="modelEntryTruckQualityMilkCollection" tabdocumentation="-1" role="dialog"
    aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="AddEditTruckQualityMilkCollection"></h5>
                <span hidden id="lblActionTruckQuality"></span>
                <span hidden id="lblTruckQualityId"></span>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @* <div class="col-6" id="ddlEntryTruckQualityBatchIdCheck">
                    <div class="form-group">
                    <label class="form-label">Batch No <span class="text-red">*</span></label>
                    <select id="ddlEntryTruckQualityBatchId" class="form-control select2 w-100" required=""
                    onchange="ClearInvalidState(this);">
                    <option value="">Select Batch No</option>
                    </select>
                    <div class="invalid-feedback">Batch No must be selected.</div>
                    </div>
                    </div> *@
                    <div class="col-6">
                        <div class="form-group">
                            <label for="txtEntrySampleNo" class="form-control-label">Sample No <span
                                    class="text-red">*</span></label>
                            <input type="text" id="txtEntryTruckQualitySampleNo" class="form-control"
                                placeholder="Enter Sample No" maxlength="50" autocomplete="off"
                                onchange="ClearInvalidState(this);">
                            <div class="invalid-feedback">Sample No can't be blank.</div>
                        </div>
                    </div>
                    <div class="col-6" hidden>
                        <div class="form-group">
                            <label class="form-label">Milk Status <span class="text-red">*</span></label>
                            <select id="ddlEntryTruckQualityMilkStatus" class="form-control select2 w-100" required=""
                                onchange="ClearInvalidState(this);">
                                <option value="">Select Milk Status</option>
                            </select>
                            <div class="invalid-feedback">Milk Status must be selected.</div>
                        </div>
                    </div>
                    <div class="col-6" hidden>
                        <div class="form-group">
                            <label for="txtEntryTruckQualityFat" class="form-control-label">FAT <span
                                    class="text-red">*</span></label>
                            <input type="text" id="txtEntryTruckQualityFat" class="form-control" placeholder="Enter FAT"
                                maxlength="50" autocomplete="off" onchange="ClearInvalidState(this);">
                            <div class="invalid-feedback">FAT can't be blank.</div>
                        </div>
                    </div>
                    <div class="col-6" hidden>
                        <div class="form-group">
                            <label for="txtEntryTruckQualitySNF" class="form-control-label">SNF <span
                                    class="text-red">*</span></label>
                            <input type="text" id="txtEntryTruckQualitySNF" class="form-control" placeholder="Enter SNF"
                                maxlength="50" autocomplete="off" onchange="ClearInvalidState(this);">
                            <div class="invalid-feedback">SNF can't be blank.</div>
                        </div>
                    </div>
                    @* <div class="col-6" id="txtEntryTruckQualityCansCheck">
                    <div class="form-group">
                    <label class="form-label">Cans <span class="text-red">*</span></label>
                    <input type="text" id="txtEntryTruckQualityCans" class="form-control"
                    placeholder="Enter Cans" maxlength="50" autocomplete="off"
                    onchange="ClearInvalidState(this);">
                    <div class="invalid-feedback">Cans can't be blank.</div>
                    </div>
                    </div> *@
                </div>
            </div>
            <div class="modal-footer" style="justify-content:flex-start">
                <button type="button" class="btn btn-primary" id="btnTruckQualitySave"
                    onclick="SaveTruckQuality();">Save</button>
            </div>
        </div>
    </div>
</div>
