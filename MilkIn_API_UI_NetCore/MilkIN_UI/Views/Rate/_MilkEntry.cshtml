                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer" style="justify-content:flex-start">
                <button type="button" class="btn btn-primary" id="btn_Save_SNF_Deduction"
                    onclick="SaveSNFDeductionEntry();">Save</button>
            </div>
        </div>
    </div>
</div>

