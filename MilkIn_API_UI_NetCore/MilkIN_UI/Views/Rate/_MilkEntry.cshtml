@{
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowEditButton = false;
    bool ShowDelButton = false;
    if (AccessString.Substring(2, 1) == "1")
    {
        ShowEditButton = true;
    }
    if (AccessString.Substring(3, 1) == "1")
    {
        ShowDelButton = true;
    }
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Milk Rate Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Live Status
                    <input id="chkEntryLiveStatus" type="checkbox" value="1" class="custom-switch-input">
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                @if (ShowEditButton == true)
                {
                    <a href="#" id="btn_Save" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i
                            class="fa fa-save mr-2"></i> Save</a>
                }
                <a href="javascript:void(0);" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>

        <!----    ----    ----    ----    Section - Success and Error Message for Data Entry    ----    ----    ----    ---->

        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <div class="row">
                <!----    ----    ----    ----    Section - Input fields - Milk Rate Details    ----    ----    ----    ---->
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Rate Chart Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryRateChartName" class="form-control"
                            placeholder="Enter Rate Chart Name" maxlength="50" autocomplete="off"
                            onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Rate Chart Name can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Milk Type <span class="text-red">*</span></label>
                        <select id="ddlEntryMilkType" class="form-control select2" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Milk Type</option>
                        </select>
                        <div class="invalid-feedback">Milk Type must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Milk Status <span class="text-red">*</span></label>
                        <select id="ddlEntryMilkStatus" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Milk Status</option>
                        </select>
                        <div class="invalid-feedback">Milk Status must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Base Unit <span class="text-red">*</span></label>
                        <select id="ddlEntryBaseUnit" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Base Unit</option>
                        </select>
                        <div class="invalid-feedback">Base Unit must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Milk Collection Shift <span class="text-red">*</span></label>
                        <select id="ddlEntryMilkCollectionShift" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Shift</option>
                        </select>
                        <div class="invalid-feedback">Milk Collection Shift must be selected.</div>
                    </div>
                </div>
            </div>
            <!----    ----    ----    ----    Tab - Assigned MCC    ----    ----    ----    ---->
            <div class="row" id="divassignmcctables">
                <div class="col-12">
                    <div class="panel panel-primary">
                        <div>
                        </div>
                    </div>
                    <div class="tab-content">
                        <div class="tab-pane active" id="tabmcc">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Milk MCC List</div>
                                    <div class="card-options">
                                        <a href="#" class="btn btn-primary btn-sm mr-2"
                                            onclick="OpenModalAssignMCC('Add','','');"><i class="fa fa-plus mr-2"></i>
                                            Add</a>
                                        <span id="lblMCCVersion" hidden style="display: none;"></span>
                                    </div>
                                </div>

                                <!----    ----    ----    ----    Section - Success and Error Message for Item Entry    ----    ----    ----    ---->
                                <div class="card-alert alert alert-success mb-0 divItemSuccess" style="display: none;">
                                    Save action was successful
                                </div>
                                <div class="card-alert alert alert-danger mb-0 divItemError" style="display: none;">
                                    Save action failed
                                </div>


                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="MCCEntryList"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 90px;">Version No</th>
                                                    <th>Applicable From</th>
                                                    <th class="text-right" style="width: 150px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableAssignMCC">

                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!----    ----    ----    ----    Tabs - Base Rate, SNF Deduction, FAT Deduction, SNF Incentive, FAT Incentive    ----    ----    ----    ---->
            <div class="row" id="divTabs">
                <div class="col-12">
                    <div class="panel panel-primary">
                        <div>
                            <div class="user-tabs mb-4">
                                <!-- Tabs -->
                                <ul class="nav panel-tabs">
                                    <li><a href="#tab1" class="active" data-toggle="tab"
                                            onclick="GetBaseRateTable();">Base Rate</a></li>
                                    <li><a href="#tab3" data-toggle="tab" onclick="GetFatDeductionTable();">FAT
                                            Deduction</a></li>
                                    <li><a href="#tab2" data-toggle="tab" onclick="GetSNFDeductionTable();">SNF
                                            Deduction</a></li>
                                    <li><a href="#tab5" data-toggle="tab" onclick="GetFatIncentivesTable();">FAT
                                            Incentives</a></li>
                                    <li><a href="#tab4" data-toggle="tab" onclick="GetSNFIncentivesTable();">SNF
                                            Incentives</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!----    ----    ----    ----    Tab - Base Rate    ----    ----    ----    ---->

                    <div class="tab-content">
                        <div class="tab-pane active" id="tab1">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Base Rate List</div>
                                    <div class="card-options">
                                        <a href="#" class="btn btn-primary btn-sm mr-2"
                                            onclick="OpenModalBaseRate('Add','','');"><i class="fa fa-plus mr-2"></i>
                                            Add</a>
                                    </div>
                                </div>

                                <!----    ----    ----    ----    Section - Success and Error Message for Item Entry    ----    ----    ----    ---->

                                <div class="card-alert alert alert-success mb-0 divItemSuccess" style="display: none;">
                                    Save action was successful
                                </div>
                                <div class="card-alert alert alert-danger mb-0 divItemError" style="display: none;">
                                    Save action failed
                                </div>

                                <!----    ----    ----    ----    Table - Base Rate    ----    ----    ----    ---->

                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableBaseRateList"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 90px;">Version No</th>
                                                    <th>Rate</th>
                                                    <th>Applicable From</th>
                                                    <th>Base FAT</th>
                                                    <th>Base SNF</th>
                                                    <th class="text-right" style="width: 150px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntryBaseRate">

                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!----    ----    ----    ----    Tab - SNF Deduction    ----    ----    ----    ---->
                        <div class="tab-pane" id="tab2">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">SNF Deduction List</div>
                                    <div class="card-options">
                                        <a href="#" class="btn btn-primary btn-sm mr-2"
                                            onclick="OpenModalSNFDeduction('Add','','');"><i
                                                class="fa fa-plus mr-2"></i> Add</a>
                                    </div>
                                </div>

                                <!----    ----    ----    ----    Section - Success and Error Message for Item Entry    ----    ----    ----    ---->

                                <div class="card-alert alert alert-success mb-0 divItemSuccess" style="display: none;">
                                    Save action was successful
                                </div>
                                <div class="card-alert alert alert-danger mb-0 divItemError" style="display: none;">
                                    Save action failed
                                </div>

                                <!----    ----    ----    ----    Table - SNF Deduction    ----    ----    ----    ---->

                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableSNFDeductionList"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 90px;">Version No</th>
                                                    <th>SNF Slab</th>
                                                    <th>Deduction per point</th>
                                                    <th>Applicable From</th>
                                                    <th class="text-right" style="width: 150px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntrySNFDeduction">

                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!----    ----    ----    ----    Tab - FAT Deduction    ----    ----    ----    ---->
                        <div class="tab-pane " id="tab3">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">FAT Deduction List</div>
                                    <div class="card-options">
                                        <a href="#" class="btn btn-primary btn-sm mr-2"
                                            onclick="OpenModalFatDeduction('Add','','');"><i
                                                class="fa fa-plus mr-2"></i> Add</a>
                                    </div>
                                </div>

                                <!----    ----    ----    ----    Section - Success and Error Message for Item Entry    ----    ----    ----    ---->

                                <div class="card-alert alert alert-success mb-0 divItemSuccess" style="display: none;">
                                    Save action was successful
                                </div>
                                <div class="card-alert alert alert-danger mb-0 divItemError" style="display: none;">
                                    Save action failed
                                </div>

                                <!----    ----    ----    ----    Table - FAT Deduction    ----    ----    ----    ---->

                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableFatDeductionList"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 90px;">Version No</th>
                                                    <th>FAT Slab</th>
                                                    <th>Deduction per point</th>
                                                    <th>Applicable From</th>
                                                    <th class="text-right" style="width: 150px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntryFatDeduction">
                                            </tbody>

                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!----    ----    ----    ----    Tab - SNF Incentives    ----    ----    ----    ---->
                        <div class="tab-pane " id="tab4">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">SNF Incentives List</div>
                                    <div class="card-options">
                                        <a href="#" class="btn btn-primary btn-sm mr-2"
                                            onclick="OpenModalSNFIncentives('Add','','');"><i
                                                class="fa fa-plus mr-2"></i> Add</a>
                                    </div>
                                </div>

                                <!----    ----    ----    ----    Section - Success and Error Message for Item Entry    ----    ----    ----    ---->

                                <div class="card-alert alert alert-success mb-0 divItemSuccess" style="display: none;">
                                    Save action was successful
                                </div>
                                <div class="card-alert alert alert-danger mb-0 divItemError" style="display: none;">
                                    Save action failed
                                </div>

                                <!----    ----    ----    ----    Table - SNF Incentives    ----    ----    ----    ---->

                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableSNFIncentivesList"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 90px;">Version No</th>
                                                    <th>SNF Slab</th>
                                                    <th>Incentive per point</th>
                                                    <th>Applicable From</th>
                                                    <th class="text-right" style="width: 150px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntrySNFIncentives">
                                            </tbody>

                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!----    ----    ----    ----    Tab - FAT Incentives    ----    ----    ----    ---->
                        <div class="tab-pane  " id="tab5">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">FAT Incentives List</div>
                                    <div class="card-options">
                                        <a href="#" class="btn btn-primary btn-sm mr-2"
                                            onclick="OpenModalFatIncentives('Add','','');"><i
                                                class="fa fa-plus mr-2"></i> Add</a>
                                    </div>
                                </div>

                                <!----    ----    ----    ----    Section - Success and Error Message for Item Entry    ----    ----    ----    ---->

                                <div class="card-alert alert alert-success mb-0 divItemSuccess" style="display: none;">
                                    Save action was successful
                                </div>
                                <div class="card-alert alert alert-danger mb-0 divItemError" style="display: none;">
                                    Save action failed
                                </div>

                                <!----    ----    ----    ----    Table - FAT Incentives    ----    ----    ----    ---->

                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableFatIncentivesList"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 90px;">Version No</th>
                                                    <th>FAT Slab</th>
                                                    <th>Incentive per point</th>
                                                    <th>Applicable From</th>
                                                    <th class="text-right" style="width: 150px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntryFatIncentives">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!----    ----    ----    ----    Section - Delete    ----    ----    ----    ---->

        <div id="divFooterDelete" class="card-footer text-right">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry"
                    onclick="ShowDeleteEntry('');"><i class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</div>

<!----    ----    ----    ----    Modal - Base Rate    ----    ----    ----    ---->

<div class="modal fade" id="modelEntryBaseRate" tabdocumentation="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="AddEditBaseRate"></h5>
                <span hidden id="lblEntryBaseRateVersionNo"></span>
                <span hidden id="lblActionBaseRate"></span>
                <span hidden id="lblEntryBaseRateId"></span>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="txtEntryBaseRateRate" class="form-control-label">Rate <span
                                    class="text-red">*</span></label>
                            <input type="text" id="txtEntryBaseRateRate" class="form-control" placeholder="Enter Rate"
                                maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Rate can't be blank.</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="txtEntryBaseRateFromDate" class="form-control-label">Applicable From <span
                                    class="text-red">*</span></label>
                            <input type="datetime-local" id="txtEntryBaseRateFromDate" class="form-control"
                                autocomplete="off" onchange="ClearInvalidState(this);" onkeydown="return false">
                            <div class="invalid-feedback">Applicable From Date can't be blank.</div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="txtEntryBaseRateBaseFat" class="form-control-label">Base FAT </label>
                            <input type="text" id="txtEntryBaseRateBaseFat" class="form-control" placeholder="Base FAT"
                                maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Base FAT can't be blank.</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="txtEntryBaseRateBaseSNF" class="form-control-label">Base SNF </label>
                            <input type="text" id="txtEntryBaseRateBaseSNF" class="form-control" placeholder="Base SNF"
                                maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Base SNF can't be blank.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="justify-content:flex-start">
                <button type="button" class="btn btn-primary" id="btn_Save_Base_Rate"
                    onclick="SaveBaseRateEntry();">Save</button>
            </div>
        </div>
    </div>
</div>

