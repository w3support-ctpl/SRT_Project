@{
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowEditButton = false;
    bool ShowDelButton = false;
    if (AccessString.Substring(2, 1) == "1")
    {
        ShowEditButton = true;
    }
    if (AccessString.Substring(3, 1) == "1")
    {
        ShowDelButton = true;
    }
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">View Milk Rate</div>
            <div class="card-options">
                <!--<a href="#" id="btn_View" class="btn btn-primary btn-sm mr-2" onclick="GetMilkRateView();"><i class="fa fa-eye mr-2"></i> View</a>-->
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <!----    ----    ----    ----    Section - Success and Error Message for Data Entry    ----    ----    ----    ---->

        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>

        <div class="card-body">
            <div class="row">
                <!----    ----    ----    ----    Section - Input fields - Milk Rate Details    ----    ----    ----    ---->
                <div class="col-lg-3 col-md-4 col-sm-12" id="divVeiwMCC">
                    <div class="form-group">
                        <label class="form-label">MCC <span class="text-red">*</span></label>
                        <select id="ddlVeiwMCC" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select MCC</option>
                        </select>
                        <div class="invalid-feedback">MCC must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12" id="divVeiwChart">
                    <div class="form-group">
                        <label class="form-label">Chart <span class="text-red">*</span></label>
                        <select id="ddlVeiwChart" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Chart</option>
                        </select>
                        <div class="invalid-feedback">Chart must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Milk Type <span class="text-red">*</span></label>
                        <select id="ddlViewMilkType" class="form-control select2" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Milk Type</option>
                        </select>
                        <span id="lblActionView" hidden style="display: none;"></span>
                        <span id="lblActionSet" hidden style="display: none;"></span>
                        <div class="invalid-feedback">Milk Type must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Milk Collection Shift <span class="text-red">*</span></label>
                        <select id="ddlViewMilkCollectionShift" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Shift</option>
                        </select>
                        <div class="invalid-feedback">Milk Collection Shift must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    @* <div class="form-group">
                    <label for="txtViewDate" class="form-control-label">Date <span class="text-red">*</span></label>
                    <div class="input-group">
                    <input type="datetime-local" id="txtViewDate" class="form-control" autocomplete="off"
                    onchange="ClearInvalidState(this);" onkeydown="return false">
                    <div class="invalid-feedback">Date can't be blank.</div>
                    <span class="input-group-append">
                    <button id="btn_View" class="btn btn-primary" type="button"
                    onclick="GetMilkRateView();">Go!</button>
                    </span>
                    </div>
                    </div> *@


                    <div class="form-group">
                        <label for="txtViewDate" class="form-label">Date <span class="text-red">*</span></label>
                        <div class="row gutters-xs">
                            <div class="col">
                                <input type="datetime-local" id="txtViewDate" class="form-control" autocomplete="off"
                                    onchange="ClearInvalidState(this);">
                            </div>

                            <span class="col-auto">
                                <button id="btn_View" class="btn btn-primary" type="button"
                                    onclick="GetMilkRateView();">Go!</button>
                            </span>
                            <div class="invalid-feedback">Date can't be blank.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row" id="divTabsView" style="display:none;">
                <div class="col-12">
                    <div class="panel panel-primary">
                        <div>
                            <div class="user-tabs mb-4">
                                <!-- Tabs -->
                                <ul class="nav panel-tabs">
                                    <li><a href="#tabview1" class="active" data-toggle="tab"
                                            onclick="GetMilkRateView();">Rate Table</a></li>
                                    <li><a href="#tabview2" data-toggle="tab" onclick="GetRateChartMatrix();">Rate
                                            Matrix</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>


                    <div class="tab-content">

                        <!----    ----    ----    ----    Tab - Rate Table    ----    ----    ----    ---->

                        <div class="tab-pane active" id="tabview1">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Rate Table</div>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableViewMilkRateList"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th>Rate Type</th>
                                                    <th>SNF - FAT</th>
                                                    <th>Rate</th>
                                                    <!--<th hidden></th>-->
                                                </tr>
                                            </thead>
                                            <tbody id="tableViewMilkRateListData">
                                                @* <tr>
                                                <th>Base Rate</th>
                                                <td>3.5 - 8.5</td>
                                                <td>32.00</td>
                                                <td hidden></td>
                                                </tr>
                                                <tr>
                                                <th>SNF Deduction</th>
                                                <td>2.5 - 3.5</td>
                                                <td>0.20</td>
                                                <td hidden></td>
                                                </tr>
                                                <tr>
                                                <th>FAT Deduction</th>
                                                <td>6.0 - 8.5</td>
                                                <td>0.20</td>
                                                <td hidden></td>
                                                </tr>
                                                <tr>
                                                <th>SNF Incentive</th>
                                                <td>3.5 - 5.0</td>
                                                <td>0.10</td>
                                                <td hidden></td>
                                                </tr>
                                                <tr>
                                                <th>FAT Incentive</th>
                                                <td>0.5 - 1.2</td>
                                                <td>0.10</td>
                                                <td hidden></td>
                                                </tr> *@
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <!----    ----    ----    ----    Tab - Rate Matrix    ----    ----    ----    ---->

                        <div class="tab-pane" id="tabview2">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Rate Matrix</div>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive" style="overflow:scroll;">
                                        <table id="tableViewMilkRateMatrix"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0"
                                            style="overflow-x: scroll; overflow-y: scroll;">
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>
</div>