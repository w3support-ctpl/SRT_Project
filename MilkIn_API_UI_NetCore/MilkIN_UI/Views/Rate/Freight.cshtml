@{
    ViewData["Title"] = "Freight";
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowAddButton = false;
    if (AccessString.Substring(1, 1) == "1")
    {
        ShowAddButton = true;
    }
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Freight Rate</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Rate</a></li>
            <li class="breadcrumb-item active" aria-current="page">Freight Rate</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Freight Rate List</div>
                    <div class="card-options">
                        @if (ShowAddButton == true)
                        {
                            <a href="#" class="btn btn-primary btn-sm" onclick="OpenModal('Add');"><i class="fa fa-plus mr-2"></i> Add</a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Vehicle No</label>
                                <select class="form-control select2" id="ddlSearchVehicleNo"
                                        required="" onchange="ClearDataTable('tableSearch');ClearInvalidState(this);" style="font-size: .8375rem;">
                                    <option value="">Select Vehicle No</option>
                                </select>
                                <div class="invalid-feedback">Vehicle No must be selected.</div>
                            </div>
                        </div>
                        <!--
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Ownership Type</label>
                                <select class="form-control select2" id="ddlSearchOwnershipType"
                                        required="" onchange="ClearDataTable('tableSearch')" style="font-size: .8375rem;">
                                    <option value="">Select Ownership Type</option>
                                </select>
                            </div>
                        </div>
                        -->
                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search" onclick="GetSearchList(this);">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Rate Type</th>
                                    <th>Amount</th>
                                    <th>Base rate for diesel</th>
                                    <th>Applicable From</th>
                                    <th class="text-right" style="width: 80px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divContent" class="row">
    </div>


</div>

<!--MODAL-->
<div class="modal fade" id="modelEntryFreight" tabdocumentation="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="AddEditFreight"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="ddlEntryRateType" class="form-control-label">Freight Rate Type <span class="text-red">*</span></label>
                            <select id="ddlEntryRateType" class="form-control select2" placeholder="Enter Freight Rate Type" onchange="ClearInvalidState(this);">
                                <option value="">Select Freight Rate Type</option>
                            </select>
                            <span id="lblEntryId" hidden style="display: none;"></span>
                            <span id="lblAction" hidden style="display: none;"></span>
                            <span id="lblVersion" hidden style="display: none;"></span>
                            <div class="invalid-feedback">Freight Rate Type must be selected.</div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="form-group">
                            <label for="txtEntryApplicableFrom" class="form-control-label">Applicable From <span class="text-red">*</span></label>
                            <input type="datetime-local" id="txtEntryApplicableFrom" class="form-control" onkeydown="return false" onchange="ClearInvalidState(this);">
                            <div class="invalid-feedback">Applicable From Date must be selected.</div>
                        </div>
                    </div>
                    <div class="col-6" id="divEntryBaseRate" style="display:none;">
                        <div class="form-group">
                            <label for="txtEntryBaseRate" class="form-control-label">Diesel Base Rate<span class="text-red">*</span></label>
                            <input type="number" id="txtEntryBaseRate" class="form-control" placeholder="Enter Base Rate" maxlength="50" autocomplete="off" onchange="ClearInvalidState(this);">
                            <div class="invalid-feedback">Base Rate must be selected.</div>
                        </div>
                    </div>
                    <div class="col-6" id="divEntryAmount" style="display:none;">
                        <div class="form-group">
                            <label for="txtEntryAmount" class="form-control-label">Amount <span class="text-red">*</span></label>
                            <input type="number" id="txtEntryAmount" class="form-control" placeholder="Enter Amount" maxlength="50" autocomplete="off" onchange="ClearInvalidState(this);">
                            <div class="invalid-feedback">Amount must be selected.</div>
                        </div>
                    </div>
                </div>
                <!-- Message on selectio of Rate Type: Fixed Per Route-->
                <div class="row" id="divMessage" style="display:none;">
                    <div class="col-12 alert alert-secondary" role="alert">
                        Please enter rate in Route Master Transaction for this Rate Type
                    </div>
                </div>



            </div>
            <div class="modal-footer" style="justify-content:flex-start">
                <button type="button" class="btn btn-primary" id="btnSave" onclick="SaveEntry();">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/tran_js/rate_freight.js" asp-append-version="true"></script>
}
