@{
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowEditButton = false;
    bool ShowDelButton = false;
    if (AccessString.Substring(2, 1) == "1")
    {
        ShowEditButton = true;
    }
    if (AccessString.Substring(3, 1) == "1")
    {
        ShowDelButton = true;
    }
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Rate Chart Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Live Status
                    <input id="chkEntryLiveStatus" type="checkbox" value="1" class="custom-switch-input">
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                @if (ShowEditButton == true)
                {
                    <a href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i
                            class="fa fa-save mr-2"></i> Save</a>
                }
                <a href="javascript:void(0);" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>

        <!----    ----    ----    ----    Section - Success and Error Message for Data Entry    ----    ----    ----    ---->

        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>


        <div class="card-body">
            <!----    ----    ----    ----    Section - Input fields - MCC Commission Details    ----    ----    ----    ---->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">MPPI Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryMPPIName" class="form-control" placeholder="Enter MPPI Name"
                            maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">MPPI Name can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Milk Type <span class="text-red">*</span></label>
                        <select id="ddlEntryMilkType" class="form-control select2" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Milk Type</option>
                        </select>
                        <div class="invalid-feedback">Milk Type must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Milk Status <span class="text-red">*</span></label>
                        <select id="ddlEntryMilkStatus" class="form-control select2" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Milk Status</option>
                        </select>
                        <div class="invalid-feedback">Milk Status must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Base Unit <span class="text-red">*</span></label>
                        <select id="ddlEntryBaseUnit" class="form-control select2" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Base Unit</option>
                        </select>
                        <div class="invalid-feedback">Base Unit must be selected.</div>
                    </div>
                </div>
                @* <div class="col-lg-3 col-md-4 col-sm-12">
                <div class="form-group">
                <label class="form-label">Milk Collection Shift <span class="text-red">*</span></label>
                <select id="ddlEntryMilkCollectionShift" class="form-control select2 w-100" required="">
                <option value="">Select Shift</option>
                </select>
                <div class="invalid-feedback">Invalid feedback</div>
                </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                <div class="form-group">
                <label class="form-label">MCC Type <span class="text-red">*</span></label>
                <select id="ddlEntryMCCType" class="form-control select2" required=""
                onchange="ClearInvalidState(this);">
                <option value="">Select MCC Type</option>
                </select>
                <div class="invalid-feedback">MCC Type must be selected.</div>
                </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                <div class="form-group">
                <label class="form-label">MCC Work Type <span class="text-red">*</span></label>
                <select id="ddlEntryMCCWorkType" class="form-control select2" required=""
                onchange="ClearInvalidState(this);">
                <option value="">Select MCC Work Type</option>
                </select>
                <div class="invalid-feedback">MCC Work Type must be selected.</div>
                </div>
                </div> *@
            </div>

            <!----    ----    ----    ----    Tab - Assigned MCC    ----    ----    ----    ---->
            <div class="row" id="divTabs">
                <div class="col-12">
                    <div class="tab-content">
                        <div class="tab-pane active" id="tab1">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Rate Slab List</div>
                                    <div class="card-options">
                                        <a id="btnAddMPPIItem" href="#" class="btn btn-primary btn-sm mr-2"
                                            onclick="OpenModalMCCCommission('Add','');"><i class="fa fa-plus mr-2"></i>
                                            Add</a>
                                    </div>
                                </div>

                                <!----    ----    ----    ----    Section - Success and Error Message for Item Entry    ----    ----    ----    ---->

                                <div class="card-alert alert alert-success mb-0 divItemSuccess" style="display: none;">
                                    Save action was successful
                                </div>
                                <div class="card-alert alert alert-danger mb-0 divItemError" style="display: none;">
                                    Save action failed
                                </div>

                                <!----    ----    ----    ----    Table - MCC Commission    ----    ----    ----    ---->

                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableMCCCommissionList"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 20px;">#</th>
                                                    <th>Min Qty</th>
                                                    <th>Max Qty</th>
                                                    <th>Rate</th>
                                                    @* <th>Base FAT</th> *@
                                                    @* <th>Base SNF</th> *@
                                                    <th>Min FAT</th>
                                                    <th>Max FAT</th>
                                                    <th>Min SNF</th>
                                                    <th>Max SNF</th>
                                                    <th>Min Protein</th>
                                                    <th>Max Protein</th>
                                                    <th>Min Ash</th>
                                                    <th>Max Ash</th>
                                                    @* <th>Service Charge</th> *@
                                                    @* <th>Applicable From</th> *@
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntryMCCCommission">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!----    ----    ----    ----    Tab - Assigned MCC    ----    ----    ----    ---->
            <div class="row" id="divMCC">
                <div class="col-12">
                    <div class="panel panel-primary">
                        <div>
                            <!--<div class="user-tabs mb-4">
                                <!-- Tabs
                                <ul class="nav panel-tabs">
                                    <li class=""><a href="#tab1" class="active" data-toggle="tab">MCC Commission Entry</a></li>
                                </ul>
                            </div>
                            -->
                        </div>
                    </div>
                    <div class="tab-content">
                        <div class="tab-pane active" id="tab1">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Assigned MCC List</div>
                                    <div class="card-options">
                                        <a href="#" class="btn btn-primary btn-sm mr-2"
                                            onclick="OpenModalMCC('Add','','');"><i class="fa fa-plus mr-2"></i> Add</a>
                                    </div>
                                </div>

                                <!----    ----    ----    ----    Section - Success and Error Message for Item Entry    ----    ----    ----    ---->

                                <div class="card-alert alert alert-success mb-0 divItemSuccess" style="display: none;">
                                    Save action was successful
                                </div>
                                <div class="card-alert alert alert-danger mb-0 divItemError" style="display: none;">
                                    Save action failed
                                </div>

                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableMCCEntryList"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 20px;">#</th>
                                                    <th>Applicable From</th>
                                                    <th class="text-right" style="width: 50px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntryMCC">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--FOOTER-->
        <div class="card-footer text-right">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry"
                    onclick="ShowDeleteEntry('');"><i class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</div>


<!--MODAL ENTRY-->
<div class="modal fade" id="modelEntryMCCCommission" tabdocumentation="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="AddEditMCCCommission"></h5>
                <span hidden id="lblActionMCCCommission"></span>
                <span hidden id="lblEntryIdMCCCommission"></span>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">


                <div class="row">

                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="form-group">
                            <label for="txtEntryMinimumQuantity" class="form-control-label">Minimum Quantity <span
                                    class="text-red">*</span></label>
                            <input type="number" id="txtEntryMinimumQuantity" class="form-control"
                                placeholder="Enter Minimum Quantity" maxlength="50" autocomplete="off"
                                onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Minimum Quantity can't be blank.</div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="form-group">
                            <label for="txtEntryMaximumQuantity" class="form-control-label">Maximum Quantity <span
                                    class="text-red">*</span></label>
                            <input type="number" id="txtEntryMaximumQuantity" class="form-control"
                                placeholder="Enter Maximum Quantity" maxlength="50" autocomplete="off"
                                onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Maximum Quantity can't be blank.</div>
                        </div>
                    </div>


                    <div class="col-lg-6 col-md-6 col-sm-12" id="divEntryMinimumFat">
                        <div class="form-group">
                            <label for="txtEntryMinimumFat" class="form-control-label">Minimum FAT <span
                                    class="text-red">*</span></label>
                            <input type="number" id="txtEntryMinimumFat" class="form-control"
                                placeholder="Enter Minimum FAT" maxlength="50" autocomplete="off"
                                onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Minimum FAT can't be blank.</div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12" id="divEntryMaximumFat">
                        <div class="form-group">
                            <label for="txtEntryMaximumFat" class="form-control-label">Maximum FAT <span
                                    class="text-red">*</span></label>
                            <input type="number" id="txtEntryMaximumFat" class="form-control"
                                placeholder="Enter Maximum FAT" maxlength="50" autocomplete="off"
                                onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Maximum FAT can't be blank.</div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12" id="divEntryMinimumSNF">
                        <div class="form-group">
                            <label for="txtEntryMinimumSNF" class="form-control-label">Minimum SNF <span
                                    class="text-red">*</span></label>
                            <input type="number" id="txtEntryMinimumSNF" class="form-control"
                                placeholder="Enter Minimum SNF" maxlength="50" autocomplete="off"
                                onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Minimum SNF can't be blank.</div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12" id="divEntryMaximumSNF">
                        <div class="form-group">
                            <label for="txtEntryMaximumSNF" class="form-control-label">Maximum SNF <span
                                    class="text-red">*</span></label>
                            <input type="number" id="txtEntryMaximumSNF" class="form-control"
                                placeholder="Enter Maximum SNF" maxlength="50" autocomplete="off"
                                onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Maximum SNF can't be blank.</div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12" id="divEntryMinimumProtein">
                        <div class="form-group">
                            <label for="txtEntryMinimumProtein" class="form-control-label">Minimum Protein <span
                                    class="text-red">*</span></label>
                            <input type="number" id="txtEntryMinimumProtein" class="form-control"
                                placeholder="Enter Minimum Protein" maxlength="50" autocomplete="off"
                                onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Minimum Protein can't be blank.</div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12" id="divEntryMaximumProtein">
                        <div class="form-group">
                            <label for="txtEntryMaximumProtein" class="form-control-label">Maximum Protein <span
                                    class="text-red">*</span></label>
                            <input type="number" id="txtEntryMaximumProtein" class="form-control"
                                placeholder="Enter Maximum Protein" maxlength="50" autocomplete="off"
                                onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Maximum Protein can't be blank.</div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12" id="divEntryMinimumAsh">
                        <div class="form-group">
                            <label for="txtEntryMinimumAsh" class="form-control-label">Minimum Ash <span
                                    class="text-red">*</span></label>
                            <input type="number" id="txtEntryMinimumAsh" class="form-control"
                                placeholder="Enter Minimum Ash" maxlength="50" autocomplete="off"
                                onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Minimum Ash can't be blank.</div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12" id="divEntryMaximumAsh">
                        <div class="form-group">
                            <label for="txtEntryMaximumAsh" class="form-control-label">Maximum Ash <span
                                    class="text-red">*</span></label>
                            <input type="number" id="txtEntryMaximumAsh" class="form-control"
                                placeholder="Enter Maximum Ash" maxlength="50" autocomplete="off"
                                onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Maximum Ash can't be blank.</div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="form-group">
                            <label for="txtEntryBaseRate" class="form-control-label">Rate <span
                                    class="text-red">*</span></label>
                            <input type="number" id="txtEntryBaseRate" class="form-control" placeholder="Enter Rate"
                                maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Rate can't be blank.</div>
                        </div>
                    </div>

                    @* <div class="col-lg-4 col-md-4 col-sm-12">
                    <div class="form-group">
                    <label for="txtEntryServiceCharge" class="form-control-label">Service Charge <span
                    class="text-red">*</span></label>
                    <input type="number" id="txtEntryServiceCharge" class="form-control"
                    placeholder="Enter Service Charge" maxlength="50" autocomplete="off"
                    onkeypress="ClearInvalidState(this);">
                    <div class="invalid-feedback">Service Charge can't be blank.</div>
                    </div>
                    </div>

                    <div class="col-lg-4 col-md-4 col-sm-12">
                    <div class="form-group">
                    <label for="txtEntryApplicableFromDateTime" class="form-control-label">Applicable From <span
                    class="text-red">*</span></label>
                    <input type="datetime-local" id="txtEntryApplicableFromDateTime" class="form-control"
                    onkeydown="return false" onkeypress="ClearInvalidState(this);">
                    <div class="invalid-feedback">Applicable From Date can't be blank.</div>
                    </div>
                    </div> *@


                </div>
            </div>
            <div class="modal-footer" style="justify-content:flex-start">
                <button type="button" class="btn btn-primary" id="btnSaveItem"
                    onclick="SaveMCCCommissionItem();">Save</button>
            </div>
        </div>
    </div>
</div>
<!-- ASSIGN MCC MODAL -->
<div class="modal fade" id="modelEntryMCCCommissionMCC" tabdocumentation="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="AddEditMCCCommissionMCC"></h5>
                <span hidden id="lblActionMCCCommissionMCC"></span>
                <span hidden id="lblAssignMCCVersion"></span>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                </div>
                <div class="row" id="divSearchField">
                    <div class="col-sm-12 col-lg-4 col-md-4">
                        <div class="form-group">
                            <label for="txtEntryApplicableDateMCC" class="form-label-search">Applicable From <span
                                    class="text-red">*</span></label>
                            <input type="datetime-local" id="txtEntryApplicableDateMCC" class="form-control"
                                onkeydown="return false" onkeypress="ClearInvalidState(this);">
                            <div class="invalid-feedback">Applicable From Date can't be blank.</div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-lg-4 col-md-4">
                        <div class="form-group">
                            <label class="form-label-search">Search Text </label>
                            <input type="text" class="form-control" id="txtSearchMCCSearchText"
                                placeholder="Search Text" maxlength="50" autocomplete="off"
                                onchange="ClearDataTable('tableSearch');">
                        </div>
                    </div>

                    <div class="col-sm-12 col-lg-4 col-md-4">
                        <button class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);"
                            type="button" title="Search" onclick="GetMCCforMCCCommission();" id="btn_Search_MCC">
                            <i class="fa fa-search mr-2"></i> Search
                        </button>
                    </div>
                </div>
                <div class="table-responsive" style="height: 300px !important;">
                    <!-- style="height: 300px !important;">-->
                    <table id="tableAssignMCCEntryModal"
                        class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                        <thead>
                            <tr>
                                @* <th>#</th>
                                <th style="width: 20px;"></th>
                                <th style="width: 150px;">MCC Code</th>
                                <th>MCC Name</th> *@
                                <th id="thAssignedMCCCheckbox" style="width: 20px;" class="text-center">
                                    <label class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input select-all checkbox"
                                            id="selectAll" />
                                        <label for="selectAll" class="custom-control-label text-dark"></label>
                                    </label>
                                </th>
                                <th>MCC Code</th>
                                <th>MCC Name</th>
                                <th>Taluka</th>
                                <th>Village</th>
                                <th hidden></th>
                            </tr>
                        </thead>
                        <tbody id="tableEntryModelMCC">
                        </tbody>

                    </table>
                </div>
            </div>
            <div id="divAssignedMCCFooter" class="modal-footer" style="justify-content:flex-start">
                @if (ShowDelButton == true)
                {
                    <button type="button" class="btn btn-primary" id="btnSaveMCC"
                        onclick="SaveMCCCommissionMCC();">Save</button>
                }
            </div>
        </div>
    </div>
</div>
