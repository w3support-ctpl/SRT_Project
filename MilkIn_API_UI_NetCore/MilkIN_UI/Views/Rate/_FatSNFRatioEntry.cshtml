@{
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowEditButton = false;
    bool ShowDelButton = false;
    if (AccessString.Substring(2, 1) == "1")
    {
        ShowEditButton = true;
    }
    if (AccessString.Substring(3, 1) == "1")
    {
        ShowDelButton = true;
    }
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">FAT SNF Ratio Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                @if (ShowEditButton == true)
                {
                <a href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i
                        class="fa fa-save mr-2"></i> Save</a>
                }
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>

        <!----    ----    ----    ----    Section - Success and Error Message for Data Entry    ----    ----    ----    ---->

        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!----    ----    ----    ----    Section - Input fields - FatSNFRatio Details    ----    ----    ----    ---->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Date <span class="text-red">*</span></label>
                        <input type="date" id="txtEntryDate" class="form-control" onchange="ClearInvalidState(this);">
                        <div class="invalid-feedback">Date can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">FAT <span class="text-red">*</span></label>
                        <input type="number" id="txtEntryFatSNFRatioFat" class="form-control" placeholder="Enter FAT"
                            autocomplete="off" onkeyup="checkAndCalculateSNF(this);" max="3"
                            onchange="ClearInvalidStateFATSNF(this);" />
                        <div class="invalid-feedback">FAT can't be blank.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">SNF <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryFatSNFRatioSNF" class="form-control" placeholder="SNF"
                            autocomplete="off" disabled />
                        <div class="invalid-feedback">Invalid SNF</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Overhead Amount <span class="text-red">*</span></label>
                        <input type="number" id="txtEntryOverheadAmount" class="form-control"
                            placeholder="Enter Overhead Amount" autocomplete="off"
                            onchange="ClearInvalidState(this);" />
                        <div class="invalid-feedback">Overhead Amount can't be blank.</div>
                    </div>
                </div>
            </div>
        </div>


        <!----    ----    ----    ----    Section - Delete    ----    ----    ----    ---->

        <div id="divFooterActions" class="card-footer text-right">
            <div class="d-flex">
                @if (ShowDelButton == true)
                {
                    <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i
                        class="fa fa-trash"></i></button>
                }
            </div>
        </div>
    </div>
</div>
