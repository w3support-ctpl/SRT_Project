<div class="card-header">
    <h3 class="card-title">Get OTP</h3>
</div>
<div class="card-body">
    <div class="form-group">
        <label class="form-label text-dark">Mobile Number <span class="text-red">*</span></label>
        <input type="text" id="txtMobileNumber" class="form-control" placeholder="Enter Mobile Number">
        <div class="invalid-feedback">Invalid Mobile No.</div>
    </div>
    <div id="divOTPEntry" class="form-group">
        <label class="form-label text-dark">Enter OTP</label>
        <input type="text" id="txtOTPForgotPassword" class="form-control" placeholder="Enter OTP">
    </div>
    <div id="loaderLogin" class="dimmer active" style="display: none; margin-top: -170px; margin-bottom: 106px;">
        <div class="lds-ring" style="margin: auto auto;"><div></div><div></div><div></div><div></div></div>
    </div>
    <div class="form-footer mt-2" id="divSendOTP">
        <a id="btnSendOTP" href="javascript: void(0)" class="btn btn-primary btn-block" onclick="SendOTP()">
            <span id="lblLogin">Send OTP</span>
        </a>
    </div>
    <div class="form-footer mt-2" id="divSubmitOTP">
        <a id="btnSubmitOTP" href="javascript: void(0)" class="btn btn-primary btn-block" onclick="SendOTP()">
            <span id="lblSubmitOTP">Submit OTP</span>
        </a>
    </div>
    <div class="form-group text-right mt-3">
        <a id="btnCancel" href="javascript: void(0)" onclick="ShowLoginDiv();">Go Back</a>
    </div>
</div>