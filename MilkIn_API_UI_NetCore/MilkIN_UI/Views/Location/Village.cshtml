@{
    ViewData["Title"] = "Village";
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowAddButton = false;
    if (AccessString.Substring(1, 1) == "1")
    {
        ShowAddButton = true;
    }
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Village</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Location</a></li>
            <li class="breadcrumb-item active" aria-current="page">Village</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Village List</div>
                    <div class="card-options">
                        @if (ShowAddButton == true)
                        {
                            <a href="#" id="btn_Add" class="btn btn-primary btn-sm" onclick="ShowAddEntry();"><i class="fa fa-plus mr-2"></i> Add</a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">State Name <span class="text-red">*</span></label>
                                <select class="form-control select2" id="ddlSearchStateName"
                                        required="" onchange="GetSearchDistrict(); ClearDataTable('tableSearch'); ClearInvalidState(this);" style="font-size: .8375rem;">
                                    <option value="">Select State Name</option>
                                </select>
                                <div class="invalid-feedback">State Name must be selected.</div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">District Name <span class="text-red">*</span></label>
                                <select class="form-control select2" id="ddlSearchDistrictName"
                                        required="" onchange="GetSearchTaluka(); ClearDataTable('tableSearch'); ClearInvalidState(this);" style="font-size: .8375rem;">
                                    <option value="">Select District Name</option>
                                </select>
                                <div class="invalid-feedback">District Name must be selected.</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Taluka Name </label>
                                <select class="form-control select2" id="ddlSearchTalukaName"
                                        required="" onchange="ClearDataTable('tableSearch'); ClearInvalidState(this);" style="font-size: .8375rem;">
                                    <option value="">Select Taluka Name</option>
                                </select>
                                <div class="invalid-feedback">Taluka Name must be selected.</div>
                            </div>
                        </div>
                      @*  <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Village Name</label>
                                <input type="text" id="txtSearchVillageName" class="form-control"
                                       placeholder="Enter Village Name"
                                       maxlength="50" autocomplete="off" onchange="ClearDataTable('tableSearch')">
                                <div class="invalid-feedback">Invalid feedback</div>
                            </div>
                        </div>*@
                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search" onclick="GetSearchList(this);">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>
                   @* <div class="row">
                    </div>*@
                    <div class="table-responsive">
                        <table id="tableSearch" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th  style="width: 20px;">#</th>
                                    <th>Village Name</th>
                                    <th>Taluka Name</th>
                                    <th>State Name</th>
                                    <th>District Name</th>
                                    <th>Status</th>
                                    <th class="text-right" style="width: 50px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divContent" class="row">
    </div>


</div>

@section Scripts{
    <script src="~/tran_js/location_village.js" asp-append-version="true"></script>
}
