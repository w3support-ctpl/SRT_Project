@{
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowEditButton = false;
    bool ShowDelButton = false;
    if (AccessString.Substring(2, 1) == "1")
    {
        ShowEditButton = true;
    }
    if (AccessString.Substring(3, 1) == "1")
    {
        ShowDelButton = true;
    }
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">District Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                @if (ShowEditButton == true)
                {
                    <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i class="fa fa-save mr-2"></i> Save</a>
                }
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>

        <!----    ----    ----    ----    Section - Success and Error Message for Data Entry    ----    ----    ----    ---->
        
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>


        <div class="card-body">
            <!----    ----    ----    ----    Section - Input fields - District Details    ----    ----    ----    ---->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">State Name <span class="text-red">*</span></label>
                        <select class="form-control select2" id="ddlEntryStateName"
                                required="" style="font-size: .8375rem;" onchange="ClearInvalidState(this);">
                            <option value="">Select State</option>
                            <option value="1" selected>All</option>
                        </select>
                        <div class="invalid-feedback">State must be selected.</div>
                        </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">District Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryDistrictName" class="form-control" placeholder="Enter District Name" maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this)">
                        <div class="invalid-feedback">District Name can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">District Code <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryDistrictCode" class="form-control" maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this)" readonly>
                        <div class="invalid-feedback">District Code can't be blank.</div>
                    </div>
                </div>
            </div>
        </div>

        <!----    ----    ----    ----    Section - Delete    ----    ----    ----    ---->

        <div id="divFooterActions" class="card-footer text-right">
            <div class="d-flex">
                @if (ShowDelButton == true)
                {
                    <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i class="fa fa-trash"></i></button>
                }
            </div>
        </div>
    </div>
</div>