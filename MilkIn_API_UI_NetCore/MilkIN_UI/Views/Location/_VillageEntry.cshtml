@{
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowEditButton = false;
    bool ShowDelButton = false;
    if (AccessString.Substring(2, 1) == "1")
    {
        ShowEditButton = true;
    }
    if (AccessString.Substring(3, 1) == "1")
    {
        ShowDelButton = true;
    }
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Village Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                @if (ShowEditButton == true)
                {
                    <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i
                            class="fa fa-save mr-2"></i> Save</a>
                }
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <!-- ENTRY SECTION -->
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">State Name <span class="text-red">*</span></label>
                        <select class="form-control select2" id="ddlEntryStateName" required=""
                            onchange="GetDistrict();ClearInvalidState(this);" style="font-size: .8375rem;">
                            <option value="">Select State</option>
                        </select>
                        <div class="invalid-feedback">State must be selected</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>

                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">District Name <span class="text-red">*</span></label>
                        <select class="form-control select2" id="ddlEntryDistrictName" required=""
                            onchange="GetTaluka();ClearInvalidState(this);" style="font-size: .8375rem;">
                            <option value="">Select District</option>
                        </select>
                        <div class="invalid-feedback">District must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Taluka Name <span class="text-red">*</span></label>
                        <select class="form-control select2" id="ddlEntryTalukaName" required=""
                            onchange="ClearInvalidState(this);" style="font-size: .8375rem;">
                            <option value="">Select Taluka</option>
                        </select>
                        <div class="invalid-feedback">Taluka Name must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Village Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryVillageName" class="form-control"
                            placeholder="Enter Village Name" maxlength="50" autocomplete="off"
                            onkeypress="ClearInvalidState(this)">
                        <div class="invalid-feedback">Village Name can't be blank.</div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Pin Code <span class="text-red"> * </span></label>
                        <input type="text" class="form-control select2" id="txtEntryPinCode"
                            placeholder="Enter Pin Code" required="" style="font-size: .8375rem;"
                            onkeypress="ClearInvalidState(this)">
                        <div class="invalid-feedback">Pin Code can't be blank.</div>
                    </div>
                </div>

            </div>
            <!-- FOOTER SECTION -->
            <div id="divFooterActions" class="card-footer text-right">
                <div class="d-flex">
                    @if (ShowDelButton == true)
                    {
                        <button type="button" class="btn btn-gray ml-auto" title="Delete Entry"
                            onclick="ShowDeleteEntry();"><i class="fa fa-trash"></i></button>
                    }
                </div>
            </div>

        </div>
    </div>
</div>