@{
    ViewData["Title"] = "Access Error";
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Access Error</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Access Error</li>
        </ol>
    </div>
    <!--/Page-Header-->

    <div class="row">
        <div class="col-lg-12 col-xl-12 col-md-12 col-sm-12">
			<div class="card">
				<div class="card-header">
                    <h3 class="card-title">Unauthorized</h3>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="col-md-2 col-sm-3">
							<img src="../images/svg/user.svg" class="imag-service w-8 h-8" alt="user">
						</div>
						<div class="col-md-10 col-sm-9">
                            <p class="mt-4 mt-sm-0">You are not authorized to access this page.</p>
                            If you feel this has happened accidentally, we request you to re-login with your credentials.  If this is happening repeatedly, please contact your system administrator.
						</div>
					</div>
				</div>
			</div>
		</div>

    </div>


</div>