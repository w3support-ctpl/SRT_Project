<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Survey Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <a href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>

        <!----    ----    ----    ----    Section - Success and Error Message for Data Entry    ----    ----    ----    ---->

        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!----    ----    ----    ----    Section - Input fields - Survey Details    ----    ----    ----    ---->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Date <span class="text-red">*</span></label>
                        <input type="date" id="txtEntryDate" class="form-control">
                        <div class="invalid-feedback">Date can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Chemist <span class="text-red">*</span></label>
                        <select id="ddlEntryChemist" class="form-control select2" required="">
                            <option value="">Select Chemist</option>
                        </select>
                        <div class="invalid-feedback">Chemist must be selected.</div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="table-responsive" style="height: 300px !important;">
                    <table id="tableEntry" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                        <thead>
                            <tr>
                                <th id="thAssignedMCCCheckbox" style="width: 20px; display:none;">#</th>
                                <th>MCC Code</th>
                                <th>MCC Name</th>
                                <th>Taluka</th>
                                <th>Village</th>
                                <th hidden></th>
                            </tr>
                        </thead>
                        <tbody id="tableEntryData">
                        </tbody>

                    </table>
                </div>
            </div>
        </div>


        <!----    ----    ----    ----    Section - Delete    ----    ----    ----    ---->

        <div id="divFooterActions" class="card-footer text-right">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry('');"><i class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</div>

