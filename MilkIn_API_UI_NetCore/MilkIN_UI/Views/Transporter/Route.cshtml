@{
    ViewData["Title"] = "Route";
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowAddButton = false;
    if (AccessString.Substring(1, 1) == "1")
    {
        ShowAddButton = true;
    }
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Route</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Transporter</a></li>
            <li class="breadcrumb-item active" aria-current="page">Route</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Route List</div>
                    <div class="card-options">
                        @if (ShowAddButton == true)
                        {
                            <a href="javascript:void(0);" class="btn btn-primary btn-sm" onclick="ShowAddEntry();"><i
                                class="fa fa-plus mr-2"></i> Add</a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Route Name</label>
                                <input type="text" class="form-control" id="txtSearchRouteName" placeholder="Route Name"
                                    maxlength="50" autocomplete="off" onchange="ClearDataTable('tableSearch')">
                                <div class="invalid-feedback">Invalid feedback</div>
                            </div>
                        </div>
                        @* <div class="col-sm-6 col-md-3 col-lg-3">
                        <div class="form-group">
                        <label class="form-label-search">Route Code</label>
                        <input type="text" class="form-control" id="txtSearchRouteCode"
                        placeholder="Route Code"
                        maxlength="50" autocomplete="off" onchange="ClearDataTable('tableSearch')">
                        <div class="invalid-feedback">Invalid feedback</div>
                        </div>
                        </div> *@
                       

                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Milk Collection Shift </label>
                                <select id="ddlSearchMilkCollectionShift" class="form-control select2 w-100" required=""
                                    onchange="ClearDataTable('tableSearch')">
                                    <option value="">Select Milk Collection Shift</option>
                                </select>
                                <div class="invalid-feedback">Milk Collection Shift must be selected.</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Status</label>
                                <select class="form-control select2" id="ddlSearchStatus" required=""
                                    onchange="ClearDataTable('tableSearch')" style="font-size: .8375rem;">
                                    <option value="">Select Status</option>
                                </select>
                                <div class="invalid-feedback">Invalid feedback</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);"
                                type="button" title="Search" onclick="GetSearchList(this);">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Route Code</th>
                                    <th>Route Name</th>
                                    <th>Shift Type</th>
                                    <th>Vehicle Type</th>
                                    <th>Status</th>
                                    <th class="text-right" style="width: 80px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">

                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divContent" class="row">
    </div>


</div>

@section Scripts {
    <script src="~/tran_js/transporter_route.js" asp-append-version="true"></script>
}
