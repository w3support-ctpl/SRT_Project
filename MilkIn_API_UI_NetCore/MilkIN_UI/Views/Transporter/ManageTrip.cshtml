@{
    ViewData["Title"] = "Manage Trip";
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowAddButton = false;
    if (AccessString.Substring(1, 1) == "1")
    {
        ShowAddButton = true;
    }
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Manage Trip</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Transporter</a></li>
            <li class="breadcrumb-item active" aria-current="page">Manage Trip</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Manage Trip List</div>

                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Manage Trip Date</label>
                                <input type="date" id="txtSearchDuration" class="form-control"
                                    placeholder="Enter Voucher Date" maxlength="50" autocomplete="off"
                                    onchange="OnDurationChnage()">
                                <div class="invalid-feedback">Manage Trip Date</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);"
                                type="button" title="Search" onclick="GetSearchList(this);">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Route Name</th>
                                    <th>Driver Name</th>
                                    <th>Vehicle No</th>
                                    <th>Vehicle Type</th>
                                    <th>Chemist</th>
                                    <th>Shift Type</th>
                                    <th>Status</th>
                                    <th class="text-right" style="width: 40px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divContent" class="row">
    </div>




</div>

@section Scripts {
    <script src="~/tran_js/transporter_manage_trip.js" asp-append-version="true"></script>
}
