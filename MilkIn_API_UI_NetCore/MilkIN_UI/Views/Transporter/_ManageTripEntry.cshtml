<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Manage Trip Entry</div>
            <div class="card-options">
                @* <label class="custom-switch" style="margin-right: 40px;">
                Live Status
                <input id="chkEntryLiveStatus" type="checkbox" value="1" class="custom-switch-input">
                <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <label class="custom-switch" style="margin-right: 40px;">
                Active Status
                <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label> *@
                <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveTripEntry(this);"><i
                        class="fa fa-truck mr-2"></i> Start Trip</a>
                <a href="javascript:void(0);" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!--ENTRY SECTION-->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Route Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryRouteName" class="form-control" placeholder="Enter Route Name"
                            maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);" disabled>
                        <div class="invalid-feedback">Route Name can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblTripDocumentId" hidden style="display: none;"></span>
                        @* <span id="lblDriverId" hidden style="display: none;"></span> *@
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Driver Name <span class="text-red">*</span></label>
                        <select id="ddlEntryDriver" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);" disabled>
                            <option value="">Select Driver</option>
                        </select>
                        <div class="invalid-feedback">Driver Name must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Vehicle No <span class="text-red">*</span></label>
                        <select id="ddlEntryVehicleNo" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);" disabled>
                            <option value="">Select Vehicle No</option>
                        </select>
                        <div class="invalid-feedback">Vehicle No must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Vehicle Type <span class="text-red">*</span></label>
                        <select id="ddlEntryVehicleType" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);" disabled>
                            <option value="">Select Vehicle Type</option>
                        </select>
                        <div class="invalid-feedback">Vehicle Type must be selected.</div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-12" id="divRouteChemist" style="display:none;">
                    <div class="form-group">
                        <label class="form-label">Route Chemist <span class="text-red">*</span></label>
                        <select id="ddlEntryRouteChemist" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);" disabled>
                            <option value="">Select Route Chemist</option>
                        </select>
                        <div class="invalid-feedback">Route Chemist must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Milk Collection Shift <span class="text-red">*</span></label>
                        <select id="ddlEntryMilkCollectionShift" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);" disabled>
                            <option value="">Select Milk Collection Shift</option>
                        </select>
                        <div class="invalid-feedback">Milk Collection Shift must be selected.</div>
                    </div>
                </div>


            </div>

            <!--ROUTE ITEM-->
            <div id="divEntryRouteItemTable" class="row">
                <div class="col-12">
                    <div class="panel panel-primary">
                        <div>
                            <div class="user-tabs mb-4">
                                <!-- Tabs -->
                                <ul class="nav panel-tabs">
                                    <li class=""><a href="#tab1" class="active" data-toggle="tab">Entry</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="tab-content">
                        <div class="tab-pane active " id="tab1">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Manage Trip Item List</div>
                                    <div class="card-options">
                                        <a id="btn_collection" href="javascript:void(0);" class="btn btn-primary btn-sm mr-2"
                                        onclick="MilkCollection();"><i
                                        class="fa fa-th-list mr-2"></i> Milk Collection</a>

                                    </div>
                                </div>
                                <div id="divItemSuccess" class="card-alert alert alert-success mb-0"
                                    style="display: none;">
                                    Save action was successful
                                </div>
                                <div id="divItemError" class="card-alert alert alert-danger mb-0"
                                    style="display: none;">
                                    Save action failed
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tablemcclists"
                                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 20px;">#</th>
                                                    @* <th>Order No</th> *@
                                                    <th>MCC</th>
                                                    <th>Weight</th>
                                                    <th>Liters</th>
                                                    <th>Expected Time</th>
                                                    <th>Arrival At</th>
                                                    <th>Status</th>
                                                    <th class="text-right" style="width: 40px;">Action</th>
                                                    @* <th class="text-right" style="width: 40px;">Action</th> *@
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntry">

                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--FOOTER DELETE-->
        @* <div id="divFooterDelete" class="card-footer text-right">
        <div class="d-flex">
        <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i
        class="fa fa-trash"></i></button>
        </div>
        </div> *@
    </div>
</div>
