@{
    ViewData["Title"] = "Survey";
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowAddButton = false;
    if (AccessString.Substring(1, 1) == "1")
    {
        ShowAddButton = true;
    }
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Survey</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Transporter</a></li>
            <li class="breadcrumb-item active" aria-current="page">Survey</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Survey List</div>
                    <div class="card-options">
                        @if (ShowAddButton == true)
                        {
                            <a href="#" class="btn btn-primary btn-sm" onclick="ShowAddEntry();"><i class="fa fa-plus mr-2"></i> Add</a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-3 col-md-3 form-group">
                            <label class="form-label-search" for="txtSearchPeriod">
                                Entry Period
                            </label>
                            <input type="text" class="form-control" name="datefilter" id="txtSearchPeriod" onchange="ClearDataTable('tableSearch')" />
                        </div>
                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button id="btn_Search" class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search" onclick="GetSearchList(this);">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>

                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Date</th>
                                    <th>Chemist</th>
                                    <th>Assigned MCC</th>
                                    <th>Survey Conducted</th>
                                    <th>Status</th>
                                    <th class="text-right" style="width: 50px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divContent" class="row">
    </div>


</div>

@section Scripts{
    <script src="~/tran_js/transporter_survey.js" asp-append-version="true"></script>
}
