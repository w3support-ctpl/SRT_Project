@{
    ViewData["Title"] = "Agent Incentive Scheme";
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Agent Incentive Scheme</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Manage</a></li>
            <li class="breadcrumb-item active" aria-current="page">Agent Incentive Scheme</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Agent Incentive Scheme List</div>

                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Incentive Scheme Period <span class="text-red">*</span> </label>
                                <input type="text" class="form-control" name="datefilter" id="txtSearchIncentiveSchemePeriod" autocomplete="off" onchange="ClearDataTable('tableSearch')" />
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Scheme Status </label>
                                <select class="form-control select2" id="ddlSearchSchemeStatus"
                                        required="" onchange="ClearDataTable('tableSearch')" style="font-size: .8375rem;">
                                    <option value="">Select Scheme Status</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);" type="button" title="Search" onclick="GetSearchList(this);">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table id="tableSearch" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Scheme Name</th>
                                    <th>Duration</th>
                                    <th>Scheme Type</th>
                                    <th>Status</th>
                                    <th class="text-right" style="width: 50px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                                <tr>
                                    <td>1</td>
                                    <td>Yearly Bonus</td>
                                    <td>01 Apr 2023 – 31 Mar 2023</td>
                                    <td>Quantity</td>
                                    <td>Active</td>
                                    <td>Open</td>
                                </tr>
                                <tr>
                                    <td>2</td>
                                    <td>Diwali Bonus</td>
                                    <td>01 Jun 2023 – 31 Oct 2023</td>
                                    <td>Quality</td>
                                    <td>Active</td>
                                    <td>Open</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divContent" class="row">
    </div>


</div>

@section Scripts {
    <script src="~/tran_js/manage_agent_incentive_scheme.js" asp-append-version="true"></script>
}
