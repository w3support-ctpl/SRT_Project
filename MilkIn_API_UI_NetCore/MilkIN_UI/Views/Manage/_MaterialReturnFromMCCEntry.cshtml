<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Material Return From MCC Entry</div>
            <div class="card-options">
                
                <a href="#" id="btn_Save" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();" style="display:none;"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Approval Status <span class="text-red">*</span></label>
                        <select id="ddlEntryApprovalStatus" class="form-control select2 w-100"
                                required="" onchange="ClearInvalidState(this);">
                            <option value="">Select Status</option>
                        </select>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                        <div class="invalid-feedback">Approval Status must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-9 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Remarks <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryRemarks" class="form-control" placeholder="Enter Remarks" maxlength="200" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Remarks</div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Return No </label>
                        <input type="text" id="txtEntryReturnNo" class="form-control" placeholder="" maxlength="50" />
                        <div class="invalid-feedback">Return No can't be blank.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Return Date </label>
                        <input type="text" id="txtEntryReturnDate" class="form-control" placeholder="" maxlength="50" />
                        <div class="invalid-feedback">Invalid Return Date</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">MCC Name </label>
                        <input type="text" id="txtEntryMCCName" class="form-control" placeholder="" maxlength="50" />
                        <div class="invalid-feedback">MCC Name can't be blank.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Agent Name </label>
                        <input type="text" id="txtEntryAgentName" class="form-control" placeholder="" maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Agent Name can't be blank.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Mobile No </label>
                        <input type="tel" id="txtEntryMobileNo" class="form-control" placeholder="" maxlength="10" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid Mobile No</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">No. of Items </label>
                        <input type="text" id="txtEntryNoOfItems" class="form-control" placeholder="" maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">No. of Items can't be blank.</div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="panel panel-primary">
                        <div>
                            <div class="user-tabs mb-4">
                                <!-- Tabs -->
                                <ul class="nav panel-tabs">
                                    <li class=""><a href="#tab1" class="active" data-toggle="tab">Returned Materials </a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="tab-content">
                        <div class="tab-pane active" id="tab1">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Returned Material List</div>
                                    <div class="card-options">
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableMaterialList" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th style="width: 20px;">#</th>
                                                    <th>Material Name</th>
                                                    <th>Material Type</th>
                                                    <th>Returned Quantity</th>
                                                    <th hidden></th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableEntryMaterialList">
                                            </tbody>

                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>