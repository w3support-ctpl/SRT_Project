<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Issue Can Entry</div>
            <div class="card-options">
                <a href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);" id="btn_Save"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>

        <!----    ----    ----    ----    Section - Success and Error Message for Data Entry    ----    ----    ----    ---->

        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">

            <!----    ----    ----    ----    Section - Input fields - Issue Empty Details    ----    ----    ----    ---->

            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Date <span class="text-red">*</span></label>
                        <input type="date" id="txtEntryDate" class="form-control"
                               maxlength="30" autocomplete="off" disabled>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                        <div class="invalid-feedback">Date can't be blank.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Route <span class="text-red">*</span></label>
                        <select id="ddlEntryRoute" class="form-control select2 w-100"
                                required="" onchange="SetShift();">
                            <option value="">Select Route</option>
                        </select>
                        <div class="invalid-feedback">Route must be selected.</div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Shift <span class="text-red">*</span></label>
                        <select id="ddlEntryShift" class="form-control select2 w-100"
                                required="" onchange="">
                            <option value="">Select Shift</option>
                        </select>
                        <div class="invalid-feedback">Shift must be selected.</div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-4 col-sm-12" style="display:none;">
                    <div class="form-group">
                        <label class="form-label">Shift <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryShift" class="form-control"
                               maxlength="30" autocomplete="off" disabled>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Vehicle No <span class="text-red">*</span>
                            <a href="#" class="btn-link" data-container="body" data-toggle="popover" data-popover-color="default" data-placement="top" title="Help" data-content="This list shows all trucks present in the system irrespective of route and shift.">
                                <i class="fa fa-info-circle ml-1"></i>
                            </a>
                            </label>
                        <select id="ddlEntryVehicleNo" class="form-control select2 w-100"
                                required="">
                            <option value="">Select Vehicle No</option>
                        </select>
                        <div class="invalid-feedback">Vehicle No must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12" style="display:none;">
                    <div class="form-group">
                        <label class="form-label">Vehicle No <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryVehicleNo" class="form-control"
                               maxlength="30" autocomplete="off" disabled>
                    </div>
                </div>

            </div>
            <div class="row" id="divissueemptycans">
                <div class="col-12">
                    <div class="panel panel-primary">
                        <div>
                        </div>
                    </div>

                    <!----    ----    ----    ----    Table - Issue Empty Cans Details    ----    ----    ----    ---->

                    <div class="tab-content">
                        <div class="tab-pane active" id="tabissueemptycans">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">Issue Cans</div>
                                    <!--
                                    <div class="card-options">
                                        <a href="#" class="btn btn-primary btn-sm mr-2" onclick="OpenModalAssignMCC('Add','0');"><i class="fa fa-plus mr-2"></i> Add</a>
                                    </div>
                                    -->
                                </div>
                                <div class="card-alert alert alert-success mb-0 divItemSuccess" style="display: none;">
                                    Save action was successful
                                </div>
                                <div class="card-alert alert alert-danger mb-0 divItemError" style="display: none;">
                                    Save action failed
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="tableEntryIssueEmptyCans" class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th hidden>MCC Id</th>
                                                    <th>MCC Name</th>
                                                    <th>Aluminium Cans With Lid </th>
                                                    <th hidden>Aluminium Can Without Lid</th>
                                                    <th hidden>Plastic Cans With Lid</th>
                                                    <th hidden>Plastic Lid Without Lid</th>
                                                    <th hidden></th>
                                                </tr>
                                            </thead>
                                            <tbody id="tableDataIssueEmptyCans">                                               
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="table-responsive">
                    
                </div>
            </div>
        </div>       
    </div>
</div>