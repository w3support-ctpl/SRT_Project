@{
    ViewData["Title"] = "Rebate";
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowAddButton = false;
    if (AccessString.Substring(1, 1) == "1")
    {
        ShowAddButton = true;
    }
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Rebate</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Voucher</a></li>
            <li class="breadcrumb-item active" aria-current="page">Rebate</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Rebate List</div>
                    <div class="card-options">
                        @if (ShowAddButton == true)
                        {
                            <a href="#" class="btn btn-primary btn-sm  mr-2" onclick="ShowPostEntry();"><i
                                    class="fa fa-plus mr-2"></i> Post</a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">

                        <div class="col-sm-6 col-md-2 col-lg-2">
                            <div class="form-group">
                                <label class="form-label-search" for="txtSearchDuration">Entry Month </label>
                                <input type="month" id="txtSearchDuration" class="form-control"
                                    placeholder="Enter Voucher Date" maxlength="50" autocomplete="off"
                                    onchange="OnDurationChnage()">
                                <div class="invalid-feedback">Invalid Voucher Date</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-2 col-lg-2">
                            <div class="form-group">
                                <label class="form-label-search" for="dllSearchEntryMCCType">MCC Type </label>
                                <select id="dllSearchEntryMCCType" class="form-control select2" required=""
                                    onchange="ClearDataTable('tableSearch');GetMCCName();">
                                    <option value="">All MCC Type</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-2 col-lg-2">
                            <div class="form-group">
                                <label class="form-label-search" for="dllSearchEntryMCCWorkType">MCC Work Type </label>
                                <select id="dllSearchEntryMCCWorkType" class="form-control select2" required=""
                                    onchange="ClearDataTable('tableSearch');GetMCCName();">
                                    <option value="">All MCC Work Type</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search" for="dllSearchEntryMCC">MCC Name </label>
                                <select id="dllSearchEntryMCC" class="form-control select2" required=""
                                    onchange="ClearDataTable('tableSearch')">
                                    <option value="">All MCC </option>
                                </select>
                            </div>
                        </div>


                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label for="ddlSearchSAPPostedStatus" class="form-label-search">Posting Status </label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <select class="form-control select2" id="ddlSearchSAPPostedStatus" required=""
                                            onchange="ClearDataTable('tableSearch')" style="font-size: .8375rem;">
                                            <option value="">Select Posting Status</option>
                                        </select>
                                    </div>

                                    <span class="col-auto">
                                        <button id="btn_MCC_View" class="btn btn-primary" type="button"
                                            onclick="GetSearchList();">Go!</button>
                                    </span>
                                    <div class="invalid-feedback">Posting Status must be selected.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive" style="height: 70vh;">
                        <table id="tableSearch"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    @* <th style="width: 20px;">#</th> *@
                                    <th class="text-center">
                                        <label class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="selectAll"
                                                onclick="SelectAllCheckbox();" />
                                            <label for="selectAll"
                                                class="custom-control-label text-dark"></label>
                                        </label>
                                    </th>
                                    <th>MCC Name</th>
                                    <th>Quantity (Ltr)</th>
                                    <th>Rebate Rate</th>
                                    <th>Amount</th>
                                    <th>Document No.</th>
                                    <th>Status</th>
                                    <th hidden></th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divContent" class="row">
    </div>



</div>


@section Scripts {
    <script src="~/tran_js/invoice_rebate.js" asp-append-version="true"></script>
}
