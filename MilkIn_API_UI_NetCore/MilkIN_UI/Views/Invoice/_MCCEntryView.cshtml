<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">MCC Details : <span id="showDetails"></span> </div>
            <div class="card-options">
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Voucher Date </label>
                        <input type="text" id="txtEntryVoucherDate" class="form-control" placeholder="Voucher Date"
                            maxlength="50" autocomplete="off" disabled>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">MCC Name </label>
                        <input type="text" id="txtEntryMCCName" class="form-control" placeholder="MCC Name"
                            maxlength="50" autocomplete="off" disabled>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Type </label>
                        <input type="text" id="txtEntryType" class="form-control" placeholder="Type" maxlength="50"
                            autocomplete="off" disabled>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Muster Cycle </label>
                        <input type="text" id="txtEntryMusterCycle" class="form-control" placeholder="Muster Cycle"
                            maxlength="50" autocomplete="off" disabled>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Amount </label>
                        <input type="text" id="txtEntryAmount" class="form-control" placeholder="Amount" maxlength="50"
                            autocomplete="off" disabled>
                    </div>
                </div>






            </div>







            <div class="card" id="divGainLoss" style="display: none;">
                <div class="card-body">
                    <h5 class="mb-4 font-weight-bold text-secondary">Gain - Loss</h5>
                    <div class="table-responsive mt-2">
                        <table id="tableGainLossList"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Date</th>
                                    <th>Collection Shift</th>
                                    <th>Milk Type</th>
                                    <th>Agent Qty(Kg)</th>
                                    <th>Agent Qty(ltr)</th>
                                    <th>Agent FAT</th>
                                    <th>Agent SNF</th>
                                    <th>Agent FAT KG</th>
                                    <th>Agent SNF KG</th>
                                    <th>Dairy Qty(Kg)</th>
                                    <th>Dairy Qty(ltr)</th>
                                    <th>Dairy FAT</th>
                                    <th>Dairy SNF</th>
                                    <th>Dairy FAT KG</th>
                                    <th>Dairy SNF KG</th>
                                    <th>FAT KG Gain Loss </th>
                                    <th>SNF KG Gain Loss </th>
                                    <th>FAT KG Rate</th>
                                    <th>SNF KG Rate</th>
                                    <th>Total Gain Loss </th>
                                    <th hidden></th>
                                </tr>
                            </thead>
                            <tbody id="tableGainLossData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card" id="divMPPI" style="display: none;">
                <div class="card-body">
                    <h5 class="mb-4 font-weight-bold text-secondary">MPPI</h5>
                    <div class="table-responsive mt-2">
                        <table id="tableMPPIList"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Date</th>
                                    <th>Collection Shift</th>
                                    <th>Milk Type</th>
                                    <th>Qty(ltr)</th>
                                    <th>Rate</th>
                                    <th>Amount</th>
                                    <th hidden></th>
                                </tr>
                            </thead>
                            <tbody id="tableMPPIData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>





        </div>
    </div>
</div>