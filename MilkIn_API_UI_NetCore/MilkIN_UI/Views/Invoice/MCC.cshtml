@{
    ViewData["Title"] = "MCC Voucher Posting";
    string AccessString = ViewBag.AccessString;
    if (AccessString == null)
    {
        AccessString = "0000";
    }
    bool ShowAddButton = false;
    if (AccessString.Substring(1, 1) == "1")
    {
        ShowAddButton = true;
    }
}
@using System.Web;
@inject IHttpContextAccessor Accessor
<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">MCC Voucher Posting</h4>
        <span id="SessionRoleId" hidden
            style="display: none;">@Accessor.HttpContext!.Session.GetString("SessionRoleId")</span>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Voucher</a></li>
            <li class="breadcrumb-item active" aria-current="page">MCC</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">MCC Voucher List</div>
                    <div class="card-options">
                        @if (ShowAddButton == true)
                        {
                            <a href="#" class="btn btn-secondary btn-sm  mr-2" onclick="ShowDummyPostEntry();">
                                <i class="fa fa-fire mr-2"></i> Dummy Posting
                            </a>
                        }
                        @if (ShowAddButton == true)
                        {
                            <a href="#" class="btn btn-secondary btn-sm  mr-2" onclick="ShowPostEntry();">
                                <i class="fa fa-paper-plane mr-2"></i> Post in SAP
                            </a>
                        }
                        @if (ShowAddButton == true)
                        {
                            <a href="javascript:void(0)" class="btn btn-secondary btn-sm mr-2" onclick="ShowAddEntry();">
                                <i class="fa fa-plus mr-2"></i> Add</a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search" for="txtSearchDuration">Voucher Date </label>
                                <input type="date" id="txtSearchDuration" class="form-control"
                                    placeholder="Enter Voucher Date" maxlength="50" autocomplete="off"
                                    onchange="OnDurationChnage()">
                                <div class="invalid-feedback">Invalid Voucher Date</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search" for="txtSearchEntryMCCType">MCC Type </label>
                                <select id="dllSearchEntryMCCType" class="form-control select2" required=""
                                    onchange="ClearDataTable('tableSearch');GetSearchMCCName();">
                                    <option value="">All MCC Type</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search" for="txtSearchEntryMCC">MCC Name </label>
                                <select id="dllSearchEntryMCC" class="form-control select2" required=""
                                    onchange="ClearDataTable('tableSearch')">
                                    <option value="">All MCC </option>
                                </select>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label for="ddlSearchSAPPostedStatus" class="form-label-search">Posting Status </label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <select class="form-control select2" id="ddlSearchSAPPostedStatus" required=""
                                            onchange="ClearDataTable('tableSearch')" style="font-size: .8375rem;">
                                            <option value="">Select Posting Status</option>
                                        </select>
                                    </div>

                                    <span class="col-auto">
                                        <button id="btn_MCC_View" class="btn btn-primary" type="button"
                                            onclick="GetSearchList();">Go!</button>
                                    </span>
                                    <div class="invalid-feedback">Posting Status must be selected.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive" style="height: 70vh;">
                        <table id="tableSearch"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    @* <th style="width: 20px;">#</th> *@
                                    <th class="text-center">
                                        <label class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="selectAllInvoice"
                                                onclick="SelectAllInvoiceCheckbox();" />
                                            <label for="selectAllInvoice"
                                                class="custom-control-label text-dark"></label>
                                        </label>
                                    </th>
                                    <th>Voucher Date</th>
                                    @* <th>Farmer Name</th> *@
                                    <th>MCC Name</th>
                                    <th>TYPE</th>
                                    <th>Muster Cycle</th>
                                    <th>Amount</th>
                                    <th>Document No.</th>
                                    <th>Status</th>
                                    @* <th>Income Status</th>
                                    <th>Deduction Status</th> *@
                                    @* <th>Action</th> *@
                                    <th class="text-right" style="width: 100px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="divContent" class="row">
    </div>
    @* <div id="divContentView" class="row">
    </div> *@


</div>

<!--MODAL-->

<div class="modal fade" id="modelEntryMCC" tabdocumentation="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="AddEditMCC">Error Log</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12" id="divEntryErrorMessage">
                        <label class="col-form-label">Error Message</label>
                        <textarea class="form-control" id="txtEntryErrorMessage" name="example-textarea-input" rows="4"
                            placeholder="Error Message"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/tran_js/invoice_mcc.js" asp-append-version="true"></script>
}
