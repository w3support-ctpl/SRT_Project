<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Vehicle Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i
                        class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!--ENTRY SECTION-->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Vehicle No <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryVehicleNo" class="form-control" placeholder="Enter Vehicle No"
                            maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Vehicle No can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Vehicle Make <span class="text-red">*</span></label>
                        <select id="ddlEntryVehicleMake" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Vehicle Make</option>
                        </select>
                        <div class="invalid-feedback">Vehicle Make must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Vehicle Type <span class="text-red">*</span></label>
                        <select id="ddlEntryVehicle" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Vehicle</option>
                        </select>
                        <div class="invalid-feedback">Vehicle type must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Chassis No </label>
                        <input type="text" id="txtEntryChassisNo" class="form-control" placeholder="Enter Chassis No"
                            maxlength="50" autocomplete="off">
                        <div class="invalid-feedback">Invalid Input</div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Ownership Type <span class="text-red">*</span></label>
                        <select id="ddlEntryOwnershipType" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Ownership Type</option>
                        </select>
                        <div class="invalid-feedback">Ownership Type must be selected.</div>
                    </div>
                </div>
                <div id="divEntryOwnerName" class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Owner Name </label>
                        <input type="text" id="txtEntryOwnerName" class="form-control" placeholder="Enter Owner Name"
                            maxlength="50" autocomplete="off">
                        <div class="invalid-feedback">Owner Name can't be blank..</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Transporter Name <span class="text-red">*</span></label>
                        <select id="ddlEntryTransporter" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Transporter Name</option>
                        </select>
                        <div class="invalid-feedback">Transporter Name must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Tare Weight (In Kg) <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryCapacityInKg" class="form-control"
                            placeholder="Enter Tare Weight in Kg" maxlength="50" autocomplete="off"
                            onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Tare Weight can't be blank.</div>
                    </div>
                </div>
                <div id="divEntryNoOfCells" class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">No of Cells </label>
                        <input type="number" id="txtEntryNoOfCells" class="form-control" placeholder="Enter No of Cells"
                            min="1" max="10" maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid No of Cells.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Vehicle Average (Km/Ltr) <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryVehicleAverage" class="form-control"
                            placeholder="Vehicle Average (Km/Ltr)" maxlength="50" autocomplete="off"
                            onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Vehicle Average (Km/Ltr) can't be blank.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">FSSAI License No <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryFSSAILicenseNo" class="form-control"
                            placeholder="Enter FSSAI License No" maxlength="14" autocomplete="off"
                            onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid FSSAI License No</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">FSSAI License Validity <span class="text-red">*</span></label>
                        <input type="date" id="txtEntryFSSAILicenseValidity" class="form-control" placeholder=""
                            autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">FSSAI License Validity can't be blank.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Labour Charge (Per Cycle) </label>
                        <input type="text" id="txtEntryLaborCharge" class="form-control"
                               placeholder="Labour Charge (Per Cycle)" maxlength="50" autocomplete="off" value="0"
                               onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Labour Charge (Per Cycle) can't be blank.</div>
                        @*<label class="custom-control custom-checkbox mt-3">
                            <input type="checkbox" id="chkEntryLaborCharge" class="custom-control-input" value="1">
                            <label for="chkEntryLaborCharge" class="custom-control-label text-dark">Applicable</label>
                        </label>*@
                    </div>
                </div>

            </div>
            <div id="divCellsTable" style="display:none;" class="row">
                <h5 class="mb-4 font-weight-bold text-secondary"></h5>
                <div class="table-responsive px-3 mt-2">
                    <table id="tableCells"
                        class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                        <thead>
                            <tr>
                                <th>Cell No</th>
                                <th>Capacity (In Ltr.)</th>
                            </tr>
                        </thead>
                        <tbody id="tableEntryCellsItem">
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
        <!--FOOTER-->
        <div id="divFooterDelete" class="card-footer text-right">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i
                        class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</div>