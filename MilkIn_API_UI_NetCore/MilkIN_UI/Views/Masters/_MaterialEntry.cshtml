<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Material Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <a href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Material Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryMaterialName" class="form-control" placeholder="Enter Material Name" maxlength="50" autocomplete="off">
                        <div class="invalid-feedback">Invalid feedback</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Material Code <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryMaterialCode" class="form-control" placeholder="Enter Material Code" maxlength="50" autocomplete="off">
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">SAP Material Code <span class="text-red">*</span></label>
                        <input type="text" id="txtEntrySapMaterialCode" class="form-control" placeholder="Enter SAP Material Code" maxlength="50" autocomplete="off">
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Is Maintained in SAP <span class="text-red">*</span></label>
                        <input type="checkbox" id="chkEntryIsMaintainedSap" class="checkbox_animated mt-3">
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer text-right">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</div>