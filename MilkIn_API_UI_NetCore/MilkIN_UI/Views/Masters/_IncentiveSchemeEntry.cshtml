<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Incentive Scheme Entry</div>
            <div class="card-options">
                <label class="custom-switch" style="margin-right: 40px;">
                    Active Status
                    <input id="chkEntryStatus" type="checkbox" value="1" class="custom-switch-input" checked>
                    <span class="custom-switch-indicator" style="margin-left: 10px"></span>
                </label>
                <a id="btn_Save" href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i
                        class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <!--ENTRY SECTION-->
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Scheme Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntrySchemeName" class="form-control" placeholder="Enter Scheme Name"
                            maxlength="50" autocomplete="off" onkeypress="ClearInvalidState(this);">
                        <div class="invalid-feedback">Scheme Name can't be blank.</div>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Incentive Type <span class="text-red">*</span></label>
                        <select id="ddlEntryIncentiveType" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);SetCriteriaLabel('');">
                            <option value="">Select Incentive Type</option>
                        </select>
                        <div class="invalid-feedback">Incentive Type must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Applicable From <span class="text-red">*</span></label>
                        <input type="date" class="form-control" id="txtEntryApplicableFrom"
                            onchange="ClearInvalidState(this);" />
                        <div class="invalid-feedback">Invalid Applicable From Date.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Applicable To <span class="text-red">*</span></label>
                        <input type="date" class="form-control" id="txtEntryApplicableTo"
                            onchange="ClearInvalidState(this);" />
                        <div class="invalid-feedback">Invalid Applicable To Date.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Frequency <span class="text-red">*</span></label>
                        <select id="ddlEntryFrequency" class="form-control select2 w-100" required=""
                            onchange="ClearInvalidState(this);">
                            <option value="">Select Frequency</option>
                            <option value="1">Yearly</option>
                            <option value="2">Monthly</option>
                            <option value="3">Weekly</option>
                        </select>
                        <div class="invalid-feedback">Frequency must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label id="lblEntryCriteria" class="form-label">Criteria <span class="text-red">*</span></label>
                        <input type="number" id="txtEntryCriteria" class="form-control" placeholder="Enter Criteria"
                            maxlength="50" autocomplete="off" onchange="ClearInvalidState(this);">
                        <div class="invalid-feedback">Criteria can't be blank.</div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-12 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Scheme Description </label>
                        <input type="text" id="txtEntryDescription" class="form-control"
                            placeholder="Enter Scheme Description" autocomplete="off"
                            onchange="ClearInvalidState(this);">
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12" id="divForFarmer">
                    <div class="form-group">
                        <label class="form-label">For Farmer? </label>
                        <label class="custom-control custom-checkbox mt-3">
                            <input type="checkbox" id="chkForFarmer" name="chkForFarmer" class="custom-control-input"
                                maxlength="50" autocomplete="off">
                            <label for="chkForFarmer" class="custom-control-label text-dark">Yes</label>
                        </label>
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12" id="divForAgent">
                    <div class="form-group">
                        <label class="form-label">For Agent? </label>
                        <label class="custom-control custom-checkbox mt-3">
                            <input type="checkbox" id="chkForAgent" name="chkForAgent" class="custom-control-input"
                                maxlength="50" autocomplete="off">
                            <label for="chkForAgent" class="custom-control-label text-dark">Yes</label>
                        </label>
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
            </div>
            <!--OTHER DETAILS-->
            <h5 class="mb-4 font-weight-bold text-secondary" id="divOtherDetails">Other Details</h5>
            <div class="row" id="divOtherDetailsRow">
                <div class="col-lg-4 col-md-12 col-sm-12">
                    <div class="form-group">
                        <div class="p-2 border mb-4">
                            <div class="upload-images d-flex">
                                <div>
                                    <img src="/images/users/male/25.jpg" alt="img" class="w73 h73 border p-0">
                                </div>
                                <div class="ml-3 mt-2">
                                    <h6 class="mb-0 mt-3 font-weight-bold">Image</h6>
                                </div>
                                <div class="float-right ml-auto">
                                    <a href="#" class="float-right btn btn-icon btn-gray btn-sm mt-5 ml-2"
                                        title="Remove"><i class="fa fa-trash-o"></i></a>
                                    <a href="#" class="float-right btn btn-icon btn-danger btn-sm mt-5"
                                        title="Change"><i class="fa fa-cloud-upload"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" id="divTabsMCCView">
                <div class="col-12">



                    <div class="tab-content">

                        <!----    ----    ----    ----    Tab - Rate Table    ----    ----    ----    ---->

                        <div class="tab-pane active" id="tabassignmccview">
                            <div class="card">
                                <div class="card-header">
                                    <div class="card-title">MCC List</div>
                                    <div class="card-options">
                                        <a href="#" class="btn btn-primary btn-sm mr-2"
                                            onclick="OpenModalAssignMCC();"><i class="fa fa-plus mr-2"></i>
                                            Add</a>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">


                                        <div class="table-responsive">
                                            <table id="tableAssignMCCEntryList"
                                                class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 20px;">#</th>
                                                        <th>MCC Code</th>
                                                        <th>MCC Name</th>
                                                        <th class="text-right" style="width: 100px;">Action</th>
                                                        <th hidden></th>
                                                        @* <th class="text-right" style="width: 50px;">Action</th> *@
                                                    </tr>
                                                </thead>
                                                <tbody id="tableEntryAssignMCC">
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>



                    </div>
                </div>
            </div>

        </div>
        <!--FOOTER-->
        <div id="divFooterDelete" class="card-footer text-right">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i
                        class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</div>




<!--MODAL SECTION-->
<div class="modal fade" id="modelEntryMCC" tabdocumentation="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add MCC</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="ddlEntryMCCName" class="form-control-label">MCC <span class="text-red">*</span></label>
                    <select id="ddlEntryMCCName" class="form-control  select2 w-100" name="ddlEntryMCCName"
                        maxlength="50" autocomplete="off" onchange="ClearInvalidState(this);">
                        <option value="">Select MCC</option>
                    </select>
                    <div class="invalid-feedback">MCC must be selected.</div>
                </div>

            </div>
            <div class="modal-footer" style="justify-content:flex-start">
                <button type="button" class="btn btn-primary" id="btn_Save_Item"
                    onclick="SaveMCCItemEntry();">Save</button>
            </div>
        </div>
    </div>
</div>