<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Facility Entry</div>
            <div class="card-options">
                <a href="#" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry(this);"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Facility Name <span class="text-red">*</span></label>
                        <input type="text" id="txtEntryFacilityName" class="form-control" placeholder="Enter Facility Name" maxlength="50" autocomplete="off">
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Facility Type <span class="text-red">*</span></label>
                        <select id="ddlEntryFacilityType" class="form-control select2 w-100"
                                required="">
                            <option value="">Select Facility Type</option>
                        </select>
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Applicable From <span class="text-red">*</span></label>
                        <input type="date" id="txtEntryApplicableFrom" class="form-control" placeholder="Enter Applicable From" maxlength="50" autocomplete="off">
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Applicable To <span class="text-red">*</span></label>
                        <input type="date" id="txtEntryApplicableTo" class="form-control" placeholder="Enter Applicable To" maxlength="50" autocomplete="off">
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>


            </div>
            <div class="row">
                <div class="col-lg-6 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Facility Description <span class="text-red">*</span></label>
                        <textarea id="txtEntryFacilityDescription" class="form-control" placeholder="Enter Facility Description" rows="1" autocomplete="off"></textarea>
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer text-right">
            <div class="d-flex">
                <button type="button" class="btn btn-gray ml-auto" title="Delete Entry" onclick="ShowDeleteEntry();"><i class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</div>
