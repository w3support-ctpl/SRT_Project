@{
    ViewData["Title"] = "Farmer Service Request";
}

<div class="side-app">
    <div class="page-header">
        <h4 class="page-title">Farmer Service Request</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Approvals L1</a></li>
            <li class="breadcrumb-item active" aria-current="page">Farmer Service Request</li>
        </ol>
    </div>
    <!--/Page-Header-->
    <div id="divSearch" class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Farmer Service Request List</div>
                    <div class="card-options">
                        <a href="javascript:void(0)" id="btn_Add" class="btn btn-primary btn-sm"
                            onclick="ShowAddEntry();"><i class="fa fa-plus mr-2"></i> Add</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Request Period </label>
                                <input type="text" name="datefilter" id="txtSearchRequestPeriod" class="form-control"
                                    autocomplete="off" value="" placeholder="">
                                <div class="invalid-feedback">Invalid feedback</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3 col-lg-3">
                            <div class="form-group">
                                <label class="form-label-search">Approval Status </label>
                                <select class="form-control select2" id="ddlSearchApprovalStatus" required=""
                                    onchange="ClearDataTable('tableSearch')" style="font-size: .8375rem;">
                                    <option value="">Select Approval Status</option>
                                </select>
                                <div class="invalid-feedback">Approval Status must be selected.</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3 col-md-3">
                            <button class="btn btn-sm btn-secondary" style="height: calc(1.47em + 1rem + 2px);"
                                type="button" title="Search" onclick="GetSearchList(this);">
                                <i class="fa fa-search mr-2"></i> Search
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="tableSearch"
                            class="hover table table-bordered table-hover table-striped w-100 border-top-0 border-bottom-0">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">#</th>
                                    <th>Request Date</th>
                                    <th>Farmer Name</th>
                                    <th>Mobile No</th>
                                    <th>Service Type</th>
                                    <th>Material/Service Requested</th>
                                    <th>Status</th>
                                    <th class="text-right" style="width: 50px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableData">

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="divContent" class="row">
    </div>
</div>

<div class="modal fade" id="modelEntryServiceRequest" tabdocumentation="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="AddEditServiceRequest">Add Service Request</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">

                    <div class="col-6">
                        <div class="form-group">
                            <label for="ddlEntryMCC" class="form-control-label">Agent Name <span
                                    class="text-red">*</span></label>
                            <select id="ddlEntryMCC" class="form-control select2" onchange="ClearInvalidState(this);GetFarmer();">
                                <option value="">Select MCC</option>
                            </select>
                            <span id="lblEntryId" hidden style="display: none;"></span>
                            <span id="lblAction" hidden style="display: none;"></span>
                            <div class="invalid-feedback">Agent Name must be selected.</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="ddlEntryFarmer" class="form-control-label">Farmer Name <span
                                    class="text-red">*</span></label>
                            <select id="ddlEntryFarmer" class="form-control select2"
                                onchange="ClearInvalidState(this);">
                                <option value="">Select Farmer</option>
                            </select>
                            <div class="invalid-feedback">Farmer Name must be selected.</div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="form-group">
                            <label for="ddlEntryServiceType" class="form-control-label">Service Type <span
                                    class="text-red">*</span></label>
                            <select id="ddlEntryServiceType" class="form-control select2"
                                onchange="ClearInvalidState(this);">
                                <option value="">Select Service Type</option>
                            </select>
                            <div class="invalid-feedback">Service Type must be selected.</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="ddlEntryMaterial" class="form-control-label">Material <span
                                    class="text-red">*</span></label>
                            <select id="ddlEntryMaterial" class="form-control select2"
                                onchange="ClearInvalidState(this);">
                                <option value="">Select Material</option>
                            </select>
                            <div class="invalid-feedback">Material must be selected.</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Quantity<span class="text-red">*</span></label>
                            <input type="text" id="txtEntryQuantity" class="form-control" placeholder="Enter Quantity"
                                maxlength="50" autocomplete="off" onchange="ClearInvalidState(this);">
                            <div class="invalid-feedback">Quantity can't be blank.</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Entry Date <span class="text-red">*</span></label>
                            <input type="date" id="txtEntryDate" class="form-control" value=""
                                onchange="ClearInvalidState(this);">
                            <div class="invalid-feedback">Invalid Entry Date</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="justify-content:flex-start">
                <button type="button" class="btn btn-primary" id="btnSave" onclick="SaveServiceEntry();">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/tran_js/approvals_farmerservice.js" asp-append-version="true"></script>
}
