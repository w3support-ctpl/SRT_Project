<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Collection Request</div>
            <div class="card-options">
                <a href="javascript:void(0)" id="btn_Save" class="btn btn-primary btn-sm mr-2" onclick="SaveEntry();"><i class="fa fa-save mr-2"></i> Save</a>
                <a href="javascript:void(0)" class="btn btn-sm btn-link" onclick="CloseEntry()">Close</a>
            </div>
        </div>
        <div id="divEntrySuccess" class="card-alert alert alert-success mb-0" style="display: none;">
            Save action was successful
        </div>
        <div id="divEntryError" class="card-alert alert alert-danger mb-0" style="display: none;">
            Save action failed
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Approval Status <span class="text-red">*</span></label>
                        <select id="ddlEntryApprovalStatus" class="form-control select2 w-100"
                                required="" onchange="ClearInvalidState(this);">
                            <option value="">Select Status</option>
                        </select>
                        <span id="lblEntryId" hidden style="display: none;"></span>
                        <span id="lblAction" hidden style="display: none;"></span>
                        <div class="invalid-feedback">Approval Status must be selected.</div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">MCC Name</label>
                        <select id="ddlEntryMCC" class="form-control select2 w-100"
                                required="" disabled>
                            <option value="">Select MCC Name</option>
                        </select>
                        <div class="invalid-feedback">MCC Name must be selected.</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Request Type</label>
                        <select id="ddlEntryRequestType" class="form-control select2 w-100"
                                required="" disabled>
                            <option value="">Select Request Type</option>
                        </select>
                        <div class="invalid-feedback">Request Type must be selected.</div>
                    </div>
                </div>
            </div>
            <div class="row" id="divExtraTime" style="display:none;">
                <div class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Request Details </label>
                        <input type="text" id="txtEntryRequestDetails" class="form-control"
                               placeholder="Enter Request Details" maxlength="50" autocomplete="off" disabled>
                        <div class="invalid-feedback">Request Details can't be blank.</div>
                    </div>
                </div>
                <div id="divOriginalTime" class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Original Time <span class="text-red">*</span></label>
                        <input type="time" id="txtEntryOriginalTime" class="form-control" placeholder="Enter Original Time"
                               maxlength="50" autocomplete="off" onchange="ClearInvalidState(this);" disabled>
                        <div class="invalid-feedback">Original Time can't be blank.</div>
                    </div>
                </div>
                <div id="divExpectedTime" class="col-lg-3 col-md-4 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Expected Time <span class="text-red">*</span></label>
                        <input type="time" id="txtEntryExpectedTime" class="form-control" placeholder="Enter Expected Time"
                               maxlength="50" autocomplete="off" onchange="ClearInvalidState(this);">
                        <div class="invalid-feedback">Expected Time can't be less than Current Time.</div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-9 col-md-8 col-sm-12">
                    <div class="form-group">
                        <label class="form-label">Request Remark </label>
                        <input type="text" id="txtEntryRequestRemark" class="form-control" placeholder="Enter Request Remark"
                               maxlength="100" autocomplete="off" disabled>
                        <div class="invalid-feedback">Invalid feedback</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>